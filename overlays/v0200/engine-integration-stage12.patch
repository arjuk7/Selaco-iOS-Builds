+    /// return the key of an object iterator
+    auto key() const -> decltype(std::declval<Base>().key())
+    {
+        auto it = --this->base();
+        return it.key();
+    }
+
+    /// return the value of an iterator
+    reference value() const
+    {
+        auto it = --this->base();
+        return it.operator * ();
+    }
+};
+}  // namespace detail
+}  // namespace nlohmann
diff --git a/libraries/cppdap/third_party/json/include/nlohmann/detail/iterators/primitive_iterator.hpp b/libraries/cppdap/third_party/json/include/nlohmann/detail/iterators/primitive_iterator.hpp
