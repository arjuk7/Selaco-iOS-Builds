index 0000000000000000000000000000000000000000..de2ff98c6c3b28db8c6b164b61c6e1107ff2b675
--- /dev/null
+++ b/src/playsim/a_lightgroup.cpp
@@ -0,0 +1,76 @@
+#include "actor.h"
+#include "g_levellocals.h"
+#include "lighting_probe_data.h"
+#include "vm.h"
+
+// LightGroup is a scripted Actor class. The VM registration macro uses the
+// ALightGroup name as a tag; it does not require a fabricated native C++ class.
+// The owned native methods address the level group by the mapthing's Score.
+static FLightGroupProbeState& GetLightGroupState(AActor* self)
+{
+	return self->Level->LightGroups[self->Score];
+}
+
+static void ActivateLightGroup(AActor* self)
+{
+	self->flags2 &= ~MF2_DORMANT;
+	if (self->Level->LightGroups.Size() != 0)
+		SetLightGroupActive(GetLightGroupState(self), true, self->Level->LightGroupUpdateGeneration);
+}
+
+static void DeactivateLightGroup(AActor* self)
+{
+	self->flags2 |= MF2_DORMANT;
+	if (self->Level->LightGroups.Size() != 0)
+		SetLightGroupActive(GetLightGroupState(self), false, self->Level->LightGroupUpdateGeneration);
+}
+
+static double GetLightGroupIntensity(AActor* self)
+{
+	return GetLightGroupState(self).Intensity;
+}
+
+static void SetLightGroupIntensityForActor(AActor* self, double intensity)
+{
+	SetLightGroupIntensity(GetLightGroupState(self), intensity, self->Level->LightGroupUpdateGeneration);
+}
+
+static void UpdateLightGroupTint(AActor* self)
+{
+	SetLightGroupTint(GetLightGroupState(self), self->args, self->Level->LightGroupUpdateGeneration);
+}
+
+DEFINE_ACTION_FUNCTION_NATIVE(ALightGroup, ActivateLightGroup, ActivateLightGroup)
+{
+	PARAM_SELF_PROLOGUE(AActor);
+	ActivateLightGroup(self);
+	return 0;
+}
