+};
+
+struct FLightGroupFileData
+{
+	uint32_t Version = 0;
+	TArray<FLightGroupFileMesh> Meshes;
+	TArray<FLightGroupFileGroup> Groups;
+};
+
+// Checked staging reader for the owned native layout. It allocates no hardware
+// buffers and does not expose the unfinished script/renderer contracts.
+bool DecodeLightGroupData(const void* bytes, size_t length,
+	FLightGroupFileData& decoded, size_t& consumed, FString& error);
