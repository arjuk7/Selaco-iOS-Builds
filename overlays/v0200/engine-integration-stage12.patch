diff --git a/src/common/rendering/hwrenderer/data/lightgroup_data.cpp b/src/common/rendering/hwrenderer/data/lightgroup_data.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..468a975bd25cc41dba62b40a6072686bef52a7b4
--- /dev/null
+++ b/src/common/rendering/hwrenderer/data/lightgroup_data.cpp
@@ -0,0 +1,140 @@
+#include "lightgroup_data.h"
+#include <cstring>
+#include <utility>
+
+namespace
+{
+struct Reader
+{
+	const uint8_t* Bytes;
+	size_t Length, Position = 0;
+	FString& Error;
+
+	bool Read(void* output, size_t length, const char* description)
+	{
+		if (length > Length - Position)
+		{
+			Error.Format("Truncated LIGHTGRP %s at byte %zu", description, Position);
+			return false;
+		}
+		if (length) std::memcpy(output, Bytes + Position, length);
+		Position += length;
+		return true;
+	}
+	bool U32(uint32_t& value)
+	{
+		uint8_t data[4];
+		if (!Read(data, 4, "uint32")) return false;
+		value = uint32_t(data[0]) | (uint32_t(data[1]) << 8) |
+			(uint32_t(data[2]) << 16) | (uint32_t(data[3]) << 24);
+		return true;
+	}
+	bool U16(uint16_t& value)
+	{
+		uint8_t data[2];
+		if (!Read(data, 2, "uint16")) return false;
+		value = uint16_t(data[0]) | (uint16_t(data[1]) << 8);
+		return true;
+	}
+	bool Float(float& value)
+	{
+		uint32_t bits;
+		if (!U32(bits)) return false;
+		std::memcpy(&value, &bits, sizeof(value));
+		return true;
+	}
+	bool Count(uint32_t& count, size_t minimumStride, const char* description)
+	{
+		if (!U32(count)) return false;
+		if (count > (Length - Position) / minimumStride)
+		{
+			Error.Format("Invalid LIGHTGRP %s count at byte %zu", description, Position - 4);
+			return false;
+		}
+		return true;
+	}
+	bool Mesh(FLightGroupFileData& result, uint32_t& index)
+	{
+		FLightGroupFileMesh mesh;
+		for (auto& word : mesh.HeaderWords)
+		{
+			uint32_t bits;
+			if (!U32(bits)) return false;
+			std::memcpy(&word, &bits, sizeof(word));
+		}
+		uint32_t count;
+		if (!Count(count, 24, "vertex")) return false;
+		mesh.Vertices.Resize(count);
+		// Explicit scalars also preserve the layout on any host endianness.
+		for (auto& vertex : mesh.Vertices)
+		{
+			if (!Float(vertex.X) || !Float(vertex.Y) || !Float(vertex.Z) ||
+				!Float(vertex.U) || !Float(vertex.V) || !U32(vertex.Color)) return false;
+		}
+		if (!Count(count, 4, "index")) return false;
+		mesh.Indices.Resize(count);
+		for (auto& value : mesh.Indices) if (!U32(value)) return false;
+		index = result.Meshes.Size();
+		result.Meshes.Push(std::move(mesh));
+		return true;
+	}
+};
+}
+
+bool DecodeLightGroupData(const void* bytes, size_t length,
+	FLightGroupFileData& decoded, size_t& consumed, FString& error)
+{
+	consumed = 0;
+	error = "";
+	if (!bytes && length)
+	{
+		error = "Missing LIGHTGRP input buffer";
+		return false;
+	}
+	Reader reader{static_cast<const uint8_t*>(bytes), length, 0, error};
+	FLightGroupFileData result;
+	if (!reader.U32(result.Version)) return false;
+	uint32_t count;
+	if (result.Version >= 2)
+	{
+		if (!reader.Count(count, 20, "shared mesh")) return false;
+		for (uint32_t i = 0; i < count; ++i)
+		{
+			uint32_t index;
+			if (!reader.Mesh(result, index)) return false;
+		}
+	}
+	if (!reader.Count(count, 30, "group")) return false;
+	for (uint32_t i = 0; i < count; ++i)
+	{
+		FLightGroupFileGroup group;
+		if (!reader.U16(group.HeaderWord)) return false;
+		for (auto& value : group.VectorA) if (!reader.Float(value)) return false;
+		for (auto& value : group.VectorB) if (!reader.Float(value)) return false;
+		uint32_t references;
+		if (!reader.Count(references, result.Version >= 2 ? 4 : 20, "mesh reference")) return false;
+		group.MeshReferences.Resize(references);
+		for (auto& reference : group.MeshReferences)
+		{
+			if (result.Version >= 2)
+			{
+				if (!reader.U32(reference)) return false;
+				if (reference >= result.Meshes.Size())
+				{
+					error.Format("Invalid LIGHTGRP mesh reference in group %u", i);
+					return false;
+				}
+			}
+			else if (!reader.Mesh(result, reference)) return false;
+		}
+		if (result.Version == 1)
+		{
+			uint32_t legacyWord;
+			if (!reader.U32(legacyWord)) return false;
+		}
+		result.Groups.Push(std::move(group));
+	}
+	consumed = reader.Position;
+	decoded = std::move(result);
+	return true;
+}
