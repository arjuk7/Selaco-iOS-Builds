+template <typename T, typename> void ZScriptDebugger::SendEvent(const T &event)
+{
+	if (m_session && m_initialized)
+	{
+		try
+		{
+			m_session->send(event);
+			// catch signal 13
+		}
+		catch (...)
+		{
+			LogInternalError("Error sending event");
+			EndSession(true);
+		}
+	}
+}
