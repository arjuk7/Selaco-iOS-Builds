+void VulkanRenderDevice::PauseBackgroundCache(bool wait)
+{
+	if (backgroundCachePaused && !wait) return;
+	for (auto& worker : bgTransferThreads)
+	{
+		worker->SetPaused(true);
+		if (wait) worker->WaitForCurrentLoad();
+	}
+	backgroundCachePaused = true;
+}
+
+void VulkanRenderDevice::ResumeBackgroundCache()
+{
+	if (!backgroundCachePaused) return;
+	for (auto& worker : bgTransferThreads) worker->SetPaused(false);
+	backgroundCachePaused = false;
+}
+
+void VulkanRenderDevice::CancelBackgroundCache(FGameTexture* tex)
+{
+	if (tex == nullptr || tex->GetUseType() == ETextureType::SWCanvas) return;
+	if (!IsBackgroundCachePaused()) PauseBackgroundCache(true);
+	for (auto& worker : bgTransferThreads) worker->WaitForCurrentLoad();
+
+	// Keep the reference queue API/order and its existing Pop behavior.
+	// Do not substitute deleteSearch: removed hardware state must be reset.
+	VkTexLoadIn input;
+	const auto matchesInput = [](void* wanted, VkTexLoadIn& item) { return item.gtex == wanted; };
+	while (secondaryTexQueue.dequeueSearch(input, tex, matchesInput))
+		if (input.tex) input.tex->SetHardwareState(IHardwareTexture::NONE, 0);
+	while (primaryTexQueue.dequeueSearch(input, tex, matchesInput))
+		if (input.tex) input.tex->SetHardwareState(IHardwareTexture::NONE, 0);
+
+	QueuedPatch patch;
+	while (patchQueue.dequeueSearch(patch, tex, [](void* wanted, QueuedPatch& item) { return item.tex == wanted; }))
+	{
+		auto mat = FMaterial::ValidateTexture(tex, patch.scaleFlags, false);
+		if (mat == nullptr) continue;
+		for (int i = 0; i < mat->NumLayers(); ++i)
+		{
+			auto hw = mat->GetLayer(i, patch.translation);
+			if (hw->GetState(0) != IHardwareTexture::READY) hw->SetHardwareState(IHardwareTexture::NONE, 0);
+		}
+	}
+	UpdateBackgroundCache(true);
+}
