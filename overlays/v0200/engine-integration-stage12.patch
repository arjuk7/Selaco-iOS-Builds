diff --git a/src/rendering/hwrenderer/hw_lightmap.cpp b/src/rendering/hwrenderer/hw_lightmap.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..abcd36e8d8439ce7e74b648fc52e63b384baf205
--- /dev/null
+++ b/src/rendering/hwrenderer/hw_lightmap.cpp
@@ -0,0 +1,268 @@
+#include "hw_lightmap.h"
+#include "g_levellocals.h"
+#include "actorinlines.h"
+#include "c_cvars.h"
+#include "v_video.h"
+#include "lightgroup_runtime.h"
+#include "lightmap_queue_contract.h"
+#include "hw_renderstate.h"
+#include "hw_viewpointbuffer.h"
+#include "hw_lightbuffer.h"
+#include "hw_bonebuffer.h"
+#include "flatvertices.h"
+#include "hwrenderer/scene/hw_drawstructs.h"
+#include <vector>
+#include <algorithm>
+
+// Defaults, types and flags match the owned FCVarDecl records.
+CVAR(Bool, lm_dynamiclightmap, true, 0)
+CVAR(Bool, lm_masterlightmaps, true, 0)
+CVAR(Int, lm_maxlightgroups, -1, 0)
+CVAR(Bool, lm_lightprobes, true, 0)
+CVAR(Bool, lm_heavyprobes, true, 0)
+
+void FRenderState::SetHeavyProbeSamples(const FHeavyProbeEvaluatedSample* samples, unsigned count)
+{
+	mStreamData.uHeavyProbeSampleCount = count;
+	for (unsigned i = 0; i < count; ++i)
+		for (unsigned lane = 0; lane < 4; ++lane)
+		{
+			mStreamData.uHeavyProbeSampleColors[i * 4 + lane] = samples[i].Color[lane];
+			mStreamData.uHeavyProbeSampleDirs[i * 4 + lane] = samples[i].Direction[lane];
+		}
+}
+
+void QueueLightmapSector(FLevelLocals* level, sector_t* sector)
+{
+	if (!sector || !level->LightmapRuntime || level->LightmapVersion < 3) return;
+	auto& runtime = *level->LightmapRuntime;
+	const auto index = sector->Index();
+	if (unsigned(index) >= runtime.Sectors.size()) return;
+	QueueLightmapSectorUpdate(runtime.FirstUpdate, runtime.LastUpdate, &runtime.Sectors[index]);
+}
+
+namespace
+{
+using Segment = FLightmapFileSectorUpdate;
+struct MeshBatch { unsigned Mesh; std::vector<const Segment*> Segments; };
+struct SourceBatch { unsigned Source; std::vector<MeshBatch> Meshes; };
+struct LayerBatch
+{
+	std::vector<const Segment*> Static;
+	std::vector<SourceBatch> Sources;
+};
+
+void BindGeometry(FRenderState& state, FLightmapGeometryBuffer& geometry)
+{
+	state.SetVertexBuffer(geometry.VertexBuffer(), 0, 0);
+	state.SetIndexBuffer(geometry.IndexBuffer());
+}
+
+void BindLightmapSource(FRenderState& state, FLightmapRuntimeData& runtime, unsigned source)
+{
+	if (source >= runtime.Sources.size() || !runtime.Sources[source])
+		I_FatalError("RenderLightGroups: source image ordinal is out of range");
+	state.SetMaterial(runtime.Sources[source].get(), EUpscaleFlags(1), 0, 0, 0, SHADER_LightmapComposite);
+}
+
+void DrawSegments(FRenderState& state, const std::vector<const Segment*>& segments)
+{
+	for (const auto* segment : segments)
+		state.DrawIndexed(DT_Triangles, segment->Values[0], segment->Values[1]);
+}
+}
+
+void RenderLightGroups(FLevelLocals* level)
+{
+	if (!level || !level->LightmapRuntime || !lm_dynamiclightmap) return;
+	auto& runtime = *level->LightmapRuntime;
+	if (runtime.Layers.empty()) return;
+	const bool cached = level->LightmapVersion >= 3;
+	std::vector<LayerBatch> prepared(runtime.Layers.size());
+	unsigned changed = 0;
+	if (cached && !runtime.FullRefresh)
+	{
+		for (auto* cell = runtime.FirstUpdate; cell; cell = cell->Next)
+		{
+			bool needsUpdate = false;
+			for (const auto& segment : cell->GroupUpdates)
+			{
+				const unsigned group = unsigned(segment.Words[0]);
+				if (group >= level->LightGroups.Size()) I_FatalError("RenderLightGroups: invalid sector group");
+				const auto& state = level->LightGroups[group];
+				if (state.Index && uint32_t(state.ChangedAt) > cell->LastUpdate) { needsUpdate = true; break; }
+			}
+			if (needsUpdate)
+			{
+				++changed;
+				for (const auto& segment : cell->StaticUpdates)
+				{
+					const unsigned layer = unsigned(segment.Words[1]);
+					if (layer >= prepared.size()) I_FatalError("RenderLightGroups: invalid static layer");
+					prepared[layer].Static.push_back(&segment);
+				}
+				for (const auto& segment : cell->GroupUpdates)
+				{
+					const auto& group = level->LightGroups[unsigned(segment.Words[0])];
+					if (!group.Active || !(group.Intensity > 0.f)) continue;
+					const unsigned meshIndex = unsigned(segment.Words[2]);
+					if (!level->LightGroupGeometry || meshIndex >= level->LightGroupGeometry->Meshes.size())
+						I_FatalError("RenderLightGroups: invalid group mesh");
+					const auto& mesh = level->LightGroupGeometry->Meshes[meshIndex];
+					const unsigned layer = unsigned(mesh.HeaderWords[2]), source = unsigned(segment.Words[1]);
+					if (layer >= prepared.size()) I_FatalError("RenderLightGroups: invalid mesh layer");
+					auto& sources = prepared[layer].Sources;
+					auto bucket = std::find_if(sources.begin(), sources.end(), [&](const SourceBatch& b) { return b.Source == source; });
+					if (bucket == sources.end()) { sources.push_back({source, {}}); bucket = sources.end() - 1; }
+					auto batch = std::find_if(bucket->Meshes.begin(), bucket->Meshes.end(), [&](const MeshBatch& b) { return b.Mesh == meshIndex; });
+					if (batch == bucket->Meshes.end()) { bucket->Meshes.push_back({meshIndex, {}}); batch = bucket->Meshes.end() - 1; }
+					batch->Segments.push_back(&segment);
+				}
+			}
+			cell->LastUpdate = level->LightGroupUpdateGeneration;
+			cell->Queued = false;
+		}
+	}
+	if (!cached || changed || runtime.FullRefresh)
+	{
+		auto& state = *screen->RenderState();
+		state.EnableStencil(false);
+		state.SetStencil(0, SOP_Keep, 0);
+		state.Clear(CT_Stencil);
+		state.EnableDepthTest(false);
+		state.EnableMultisampling(false);
+		state.EnableFog(false);
+		state.EnableModelMatrix(false);
+		state.EnableTextureMatrix(false);
+		state.EnableBrightmap(false);
+		state.EnableTexture(true);
+		state.SetTextureMode(TM_NORMAL);
+		state.SetDynLight(0, 0, 0);
+		state.SetLightProbeColor(0, 0, 0);
+		screen->mLights->Clear();
+		screen->mBones->Clear();
+		screen->mViewpoints->Clear();
+		for (unsigned layerIndex = 0; layerIndex < runtime.Layers.size(); ++layerIndex)
+		{
+			screen->RenderLightmap(layerIndex, [&](IntRect& bounds)
+			{
+				if (lm_maxlightgroups == 0) return;
+				auto& layer = runtime.Layers[layerIndex];
+				screen->SetViewportRects(&bounds);
+				state.SetViewport(0, 0, level->LMTextureWidth, level->LMTextureHeight);
+				state.SetScissor(0, 0, level->LMTextureWidth, level->LMTextureHeight);
+				screen->mViewpoints->Set2D(state, level->LMTextureWidth, level->LMTextureHeight);
+				if (lm_masterlightmaps)
+				{
+					BindLightmapSource(state, runtime, layerIndex);
+					state.SetRenderStyle(STYLE_Source);
+					state.SetObjectColor(0xffffffff);
+					if (!runtime.FullRefresh && layer.MergedIndexCount >= 0)
+					{
+						if (layer.MergedIndexCount > 0)
+						{
+							BindGeometry(state, *layer.Merged);
+							if (cached) DrawSegments(state, prepared[layerIndex].Static);
+							else state.DrawIndexed(DT_Triangles, 0, layer.MergedIndexCount);
+						}
+					}
+					else { BindGeometry(state, *layer.Quad); state.DrawIndexed(DT_Triangles, 0, 6); }
+				}
+				state.SetRenderStyle(STYLE_Add);
+				if (cached && !runtime.FullRefresh)
+				{
+					for (const auto& source : prepared[layerIndex].Sources)
+					{
+						BindLightmapSource(state, runtime, source.Source);
+						for (const auto& batch : source.Meshes)
+						{
+							auto& mesh = level->LightGroupGeometry->Meshes[batch.Mesh];
+							if (unsigned(mesh.HeaderWords[0]) >= level->LightGroups.Size()) I_FatalError("RenderLightGroups: invalid mesh group");
+							state.SetObjectColor(level->LightGroups[mesh.HeaderWords[0]].PackedColor);
+							BindGeometry(state, *mesh.Geometry);
+							DrawSegments(state, batch.Segments);
+						}
+					}
+				}
+				else
+				{
+					int activeGroups = 0;
+					for (const auto& group : level->LightGroups)
+					{
+						if (!group.Active) continue;
+						if (lm_maxlightgroups >= 0 && activeGroups >= lm_maxlightgroups) break;
+						state.SetObjectColor(group.PackedColor);
+						for (const auto meshIndex : group.MeshReferences)
+						{
+							if (!level->LightGroupGeometry || meshIndex >= level->LightGroupGeometry->Meshes.size()) I_FatalError("RenderLightGroups: invalid group mesh ordinal");
+							auto& mesh = level->LightGroupGeometry->Meshes[meshIndex];
+							if (unsigned(mesh.HeaderWords[2]) != layerIndex) continue;
+							BindLightmapSource(state, runtime, unsigned(mesh.HeaderWords[1]));
+							BindGeometry(state, *mesh.Geometry);
+							state.DrawIndexed(DT_Triangles, 0, mesh.IndexCount);
+						}
+						++activeGroups;
+					}
+				}
+			});
+		}
+		screen->SetViewportRects(nullptr);
+		state.SetRenderStyle(STYLE_Translucent);
+		state.SetVertexBuffer(screen->mVertexData);
+		state.EnableTextureMatrix(false);
+		state.EnableBrightmap(true);
+		state.SetTextureMode(TM_NORMAL);
+		state.EnableFog(false);
+		state.SetScreenFade(1.f);
+		state.SetColor(1.f, 1.f, 1.f, 1.f, 0);
+	}
+	for (auto* cell = runtime.FirstUpdate; cell; cell = cell->Next) cell->Queued = false;
+	runtime.FirstUpdate = runtime.LastUpdate = nullptr;
+	runtime.FullRefresh = false;
+	if (cached)
+	{
+		if (level->LightGroupUpdateGeneration == UINT32_MAX)
+		{
+			for (auto& group : level->LightGroups) group.ChangedAt = 0;
+			for (auto& cell : runtime.Sectors) cell.LastUpdate = 0;
+			runtime.FullRefresh = true;
+			level->LightGroupUpdateGeneration = 0;
+		}
+		++level->LightGroupUpdateGeneration;
+	}
+}
+
+bool GetEvaluatedLightProbeColor(FLevelLocals* level, const LightProbe* probe, float color[3])
+{
+	return probe && EvaluateLightProbe(*probe, level->LightGroups, color);
+}
+
+bool GetActorLightProbeColor(FLevelLocals* level, AActor* actor, float color[3])
+{
+	if (!actor || !lm_lightprobes || (lm_heavyprobes && actor->HeavyProbeIndex >= 0)) return false;
+	AActor* sampled = actor;
+	if (actor->flags9 & MF9_MASTERLIGHTPROBES)
+	{
+		if (actor->master && actor->master->ObjectFlags & OF_EuthanizeMe) actor->master = nullptr;
+		if (actor->master) sampled = actor->master;
+	}
+	double x = sampled->X(), y = sampled->Y();
+	if (sampled->renderflags & RF_WALLSPRITE)
+	{
+		x += sampled->Angles.Yaw.Cos() * level->LPCellSize;
+		y += sampled->Angles.Yaw.Sin() * level->LPCellSize;
+	}
+	return GetEvaluatedLightProbeColor(level, FindLightProbe(level, float(x), float(y),
+		float(sampled->Z() + sampled->Height * 0.5), float(sampled->floorz)), color);
+}
+
+void ApplyActorHeavyProbe(FRenderState& state, FLevelLocals* level, AActor* actor)
+{
+	if (!lm_heavyprobes || !actor || actor->HeavyProbeIndex < 0 ||
+		unsigned(actor->HeavyProbeIndex) >= level->HeavyLightProbes.Size()) return;
+	const auto& probe = level->HeavyLightProbes[actor->HeavyProbeIndex];
+	FHeavyProbeEvaluatedSample samples[4];
+	if (!EvaluateHeavyProbe(probe, level->LightGroups, samples))
+		I_FatalError("ApplyActorHeavyProbe: invalid group contribution");
+	state.SetHeavyProbeSamples(samples, probe.Count);
+}
