+bool FGameTexture::IsBackgroundLoading(int translation)
+{
+	for (auto mat : Material)
+	{
+		if (!mat || mat->IsHardwareCached(translation)) continue;
+		for (int i = 0; i < mat->NumLayers(); ++i)
+		{
+			auto hw = mat->GetLayer(i, translation);
+			if (hw == nullptr) continue;
+			auto state = hw->GetState(0);
+			if (state != IHardwareTexture::NONE && state != IHardwareTexture::READY && state != IHardwareTexture::FAILED) return true;
+		}
+	}
+	return false;
+}
+
+void FGameTexture::UnloadHardwareData()
+{
+	if (GetUseType() == ETextureType::SWCanvas) return;
+	if (IsBackgroundLoading()) screen->CancelBackgroundCache(this);
+	TArray<FTexture*> layers;
+	GetLayers(layers);
+	for (auto layer : layers) if (layer->GetImage()) layer->CleanHardwareTextures();
+	for (auto mat : Material) if (mat) mat->DeleteDescriptors();
+}
