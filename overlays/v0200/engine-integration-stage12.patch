--- /dev/null
+++ b/src/playsim/p_pooledparticle_fading.h
@@ -0,0 +1,35 @@
+#pragma once
+#include <cstdint>
+
+// Scalar behavior reconstructed from fd4b0b60d8 at 0x14019a57f and
+// 0x1402a8705. Preserve the reference comparison/minimum behavior for NaNs.
+inline float ApplyDefinedParticleFadeIn(float opacity, int16_t tics, float fadeTime)
+{
+    if (fadeTime > 0.0f)
+    {
+        float factor = float(tics) / fadeTime;
+        factor = factor < 1.0f ? factor : 1.0f;
+        opacity *= factor;
+    }
+    return opacity;
+}
+
+inline double ApplyDefinedParticleDistanceChance(double chance, double distance,
+    float start, float end, bool ignoreDistance)
+{
+    if (!ignoreDistance && end > 0.0f && distance > double(start))
+    {
+        const float span = end - start;
+        if (span > 0.0f)
+        {
+            const double ratio = (distance - double(start)) / double(span);
+            const double capped = ratio < 1.0 ? ratio : 1.0;
+            chance *= 1.0 - capped;
+        }
+        else
+        {
+            chance = 0.0;
+        }
+    }
+    return chance;
+}
