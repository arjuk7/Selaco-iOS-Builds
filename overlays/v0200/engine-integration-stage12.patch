+    {"GainHF", 4, PropertyKind::Float, 0, 1.0},
+    {"DecayTime", 6, PropertyKind::Float, 0.10000000149011612, 20.0},
+    {"DecayHFRatio", 7, PropertyKind::Float, 0.10000000149011612, 2.0},
+    {"ReflectionsGain", 9, PropertyKind::Float, 0, 3.1600000858306885},
+    {"ReflectionsDelay", 10, PropertyKind::Float, 0, 0.30000001192092896},
+    {"LateReverbGain", 12, PropertyKind::Float, 0, 10.0},
+    {"LateReverbDelay", 13, PropertyKind::Float, 0, 0.10000000149011612},
+    {"EchoTime", 15, PropertyKind::Float, 0.07500000298023224, 0.25},
+    {"EchoDepth", 16, PropertyKind::Float, 0, 1.0},
+    {"ModulationTime", 17, PropertyKind::Float, 0.03999999910593033, 4.0},
+    {"ModulationDepth", 18, PropertyKind::Float, 0, 1.0},
+    {"HFReference", 20, PropertyKind::Float, 1000.0, 20000.0},
+    {"LFReference", 21, PropertyKind::Float, 20.0, 1000.0},
+    {"RoomRolloffFactor", 22, PropertyKind::Float, 0, 10.0},
+    {"AirAbsorbtionGainHF", 19, PropertyKind::Float, 0.8920000195503235, 1.0},
+    {"DecayHFLimit", 23, PropertyKind::Int, 0, 1},
+};
+
+const EffectType EffectTypes[] = {
+    {"Reverb", 1, ReverbProperties, 13},
+    {"Chorus", 2, ChorusProperties, 6},
+    {"Distortion", 3, DistortionProperties, 5},
+    {"Echo", 4, EchoProperties, 5},
+    {"Flange", 5, FlangeProperties, 6},
+    {"FrequencyShift", 6, FrequencyShiftProperties, 3},
+    {"VocalMorph", 7, VocalMorphProperties, 6},
+    {"PitchShift", 8, PitchShiftProperties, 2},
+    {"RingModulator", 9, RingModulatorProperties, 3},
+    {"AutoWah", 10, AutoWahProperties, 4},
+    {"Equalizer", 12, EqualizerProperties, 10},
+    {"EAXReverb", 32768, EAXReverbProperties, 19},
+};
+
+
+bool ReadEnum(FScanner& sc, const Property& property, int& value)
+{
+    sc.MustGetString();
+    if (property.Kind == PropertyKind::Direction)
+    {
+        if (!stricmp(sc.String, "down")) { value = 0; return true; }
+        if (!stricmp(sc.String, "up")) { value = 1; return true; }
+        if (!stricmp(sc.String, "off")) { value = 2; return true; }
+    }
+    else
+    {
+        if (!stricmp(sc.String, "sin")) { value = 0; return true; }
+        if (!stricmp(sc.String, "triangle")) { value = 1; return true; }
+        if (property.Kind == PropertyKind::Waveform3 && !stricmp(sc.String, "saw")) { value = 2; return true; }
+    }
+    sc.ScriptError("Invalid value for property '%s': %s", property.Name, sc.String);
+    // In the scanner's explicit no-fatal mode, the native error branch skips
+    // the parameter. It must not silently append a made-up enum value.
+    return false;
+}
+
+FSoundEffectStage ReadStage(FScanner& sc, const EffectType& type)
+{
+    FSoundEffectStage stage;
+    stage.Type = type.Id;
+    if (sc.CheckFloat())
+    {
+        stage.Gain = float(sc.Float);
+        // The native parser checks the converted float for slot gain, but the
+        // original double for effect parameters below. Do not merge the checks.
+        if (stage.Gain < 0.f || stage.Gain > 1.f)
+            sc.ScriptError("AudioFX: Gain for effect '%s' must be between 0 and 1, found: %g", type.Name, double(stage.Gain));
+    }
+    sc.MustGetStringName("{");
+    while (sc.GetString())
+    {
+        const Property* found = nullptr;
+        for (unsigned i = 0; i < type.Count; ++i)
+        {
+            if (!stricmp(sc.String, type.Properties[i].Name))
+            {
+                found = &type.Properties[i];
+                break;
+            }
+        }
+        if (!found)
+        {
+            if (!stricmp(sc.String, "}")) break;
+            // Native behavior: an unknown property token is skipped singly.
+            continue;
+        }
+        const auto& property = *found;
+        if (property.Kind == PropertyKind::Float)
+        {
+            sc.MustGetFloat();
+            float value = float(sc.Float);
+            stage.FloatParameters.Push({ property.Id, value });
+            if (sc.Float < property.Min || sc.Float > property.Max)
+                sc.ScriptError("AudioFX: Value '%s' must be between %g and %g, found: %g", property.Name, property.Min, property.Max, double(value));
+        }
+        else if (property.Kind == PropertyKind::Int)
+        {
+            sc.MustGetNumber();
+            stage.IntParameters.Push({ property.Id, sc.Number });
+            if (sc.Number < int(property.Min) || sc.Number > int(property.Max))
+                sc.ScriptError("AudioFX: Value '%s' must be between %d and %d, found: %d", property.Name, int(property.Min), int(property.Max), sc.Number);
+        }
+        else
+        {
+            // RingModulator.Waveform intentionally has native property ID 5
+            // and accepts sin/triangle/saw, even though EFX documents ID 3.
+            int value;
+            if (ReadEnum(sc, property, value))
+                stage.IntParameters.Push({ property.Id, value });
+        }
+    }
+    return stage;
+}
+} // namespace
+
+FSoundEffectLibrary SoundEffects;
+
+int FSoundEffectLibrary::Find(const FString& name) const
+{
+    auto index = NameToIndex.CheckKey(name);
+    return index ? *index : -1;
+}
+
+void FSoundEffectLibrary::Parse(FScanner& sc)
+{
+    Definitions.Clear();
+    while (sc.GetString())
+    {
+        FNamedSoundEffect definition;
+        definition.Name = sc.String;
+        if (NameToIndex.CheckKey(definition.Name))
+            sc.ScriptError("Audio effect \"%s\" has already been defined.", definition.Name.GetChars());
+        Printf("AUDIOFX: Found effect definition '%s'\n", definition.Name.GetChars());
+        sc.MustGetStringName("{");
+        while (sc.GetString())
+        {
+            if (!stricmp(sc.String, "}")) break;
+            const EffectType* found = nullptr;
+            for (const auto& type : EffectTypes)
+            {
+                if (!stricmp(sc.String, type.Name))
+                {
+                    found = &type;
+                    break;
+                }
+            }
+            if (!found)
+                sc.ScriptError("Unknown AudioFX effect type: %s", sc.String);
+            else
+                definition.Stages.Push(ReadStage(sc, *found));
+        }
+        int index = int(Definitions.Size());
+        NameToIndex[definition.Name] = index;
+        Definitions.Push(std::move(definition));
+    }
+}
+
+void S_LoadAudioEffects()
+{
+    int last = 0;
+    int lump;
+    while ((lump = fileSystem.FindLump("AUDIOFX", &last)) != -1)
+    {
+        FScanner sc(lump);
+        SoundEffects.Parse(sc);
+    }
+}
