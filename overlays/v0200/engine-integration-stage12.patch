+{
+	PARAM_PROLOGUE;
+	PARAM_STRING(spriteName);
+	PARAM_STRING(frames);
+	PARAM_BOOL(unloadAngles);
+	std::string name(spriteName.GetChars());
+	name += "fx";
+	for (unsigned i = 0; i < frames.Len(); ++i)
+	{
+		name[spriteName.Len()] = frames[i];
+		for (char angle = '0'; angle <= (unloadAngles ? '8' : '0'); ++angle)
+		{
+			name[spriteName.Len() + 1] = angle;
+			auto id = TexMan.CheckForTexture(name.c_str(), ETextureType::Sprite, 0);
+			auto tex = TexMan.GetGameTexture(id, false);
+			if (tex) tex->UnloadHardwareData();
+		}
+	}
+	// The owned thunk returns zero VM results despite its bool declaration.
+	// No invented success value is supplied.
+	return 0;
+}
