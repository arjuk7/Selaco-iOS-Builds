+		.Type(VK_IMAGE_VIEW_TYPE_2D_ARRAY)
+		.Image(Lightmap.Image.get(), VK_FORMAT_R8G8B8A8_UNORM)
+		.DebugName("VkRenderBuffers.LightmapView")
+		.Create(fb->device.get());
+	for (int layer = 0; layer < layers; ++layer)
+	{
+		VkLightmapSlice slice;
+		slice.View = ImageViewBuilder()
+			.Type(VK_IMAGE_VIEW_TYPE_2D)
+			.Image(Lightmap.Image.get(), LightmapSliceFormat,
+				VK_IMAGE_ASPECT_COLOR_BIT, 0, layer, 0, 1)
+			.DebugName("VkRenderBuffers.LightmapSlice")
+			.Create(fb->device.get());
+		LightmapSlices.push_back(std::move(slice));
+	}
+	VkImageTransition()
+		.AddImage(&Lightmap, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, false, 0, 1, 0, layers)
+		.Execute(fb->GetCommands()->GetTransferCommands());
+}
