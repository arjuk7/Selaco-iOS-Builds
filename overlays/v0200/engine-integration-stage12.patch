+bool EvaluateLightProbe(const FLightProbeFileData& probe, const TArray<FLightGroupProbeState>& groups, float out[3]);
+bool EvaluateHeavyProbe(const FHeavyProbeFileData& probe, const TArray<FLightGroupProbeState>& groups, FHeavyProbeEvaluatedSample out[4]);
diff --git a/src/common/rendering/hwrenderer/data/lightmap_bc7.cpp b/src/common/rendering/hwrenderer/data/lightmap_bc7.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..fd127c72be0fb920811e920572868eb7a26b9baf
--- /dev/null
+++ b/src/common/rendering/hwrenderer/data/lightmap_bc7.cpp
@@ -0,0 +1,56 @@
+#include "lightmap_bc7.h"
+#include <algorithm>
+#include <cstring>
+#include <limits>
+
+#define BCDEC_STATIC
+#define BCDEC_IMPLEMENTATION
+#include "../../../../../libraries/bcdec/bcdec.h"
+
+bool DecodeBC7Lightmap(const void* source, size_t sourceBytes, uint32_t width, uint32_t height,
+	std::vector<uint8_t>& rgba, std::string& error)
+{
+	error.clear();
+	if (!source || !width || !height)
+	{
+		error = "BC7 lightmap requires a source and positive dimensions";
+		return false;
+	}
+	uint64_t blockWidth = (uint64_t(width) + 3) / 4;
+	uint64_t blockHeight = (uint64_t(height) + 3) / 4;
+	uint64_t blockCount = blockWidth * blockHeight;
+	uint64_t pixelCount = uint64_t(width) * height;
+	if (blockCount > std::numeric_limits<size_t>::max() / 16 ||
+		pixelCount > std::numeric_limits<size_t>::max() / 4)
+	{
+		error = "BC7 lightmap extent exceeds addressable storage";
+		return false;
+	}
+	uint64_t expectedBytes = blockCount * 16;
+	uint64_t outputBytes = pixelCount * 4;
+	if (expectedBytes != sourceBytes || outputBytes > std::numeric_limits<size_t>::max() ||
+		outputBytes > rgba.max_size())
+	{
+		error = "BC7 lightmap source size or output extent is invalid";
+		return false;
+	}
+	std::vector<uint8_t> decoded(size_t(outputBytes), uint8_t(0));
+	auto* bytes = static_cast<const uint8_t*>(source);
+	for (uint32_t by = 0; by < blockHeight; ++by)
+	{
+		for (uint32_t bx = 0; bx < blockWidth; ++bx)
+		{
+			uint8_t block[4 * 4 * 4];
+			bcdec_bc7(bytes + (size_t(by) * size_t(blockWidth) + bx) * 16, block, 4 * 4);
+			uint32_t rows = std::min(4u, height - by * 4);
+			uint32_t columns = std::min(4u, width - bx * 4);
+			for (uint32_t row = 0; row < rows; ++row)
+			{
+				auto offset = (size_t(by * 4 + row) * width + bx * 4) * 4;
+				std::memcpy(decoded.data() + offset, block + row * 16, columns * 4);
+			}
+		}
+	}
+	rgba = std::move(decoded);
+	return true;
+}
diff --git a/src/common/rendering/hwrenderer/data/lightmap_bc7.h b/src/common/rendering/hwrenderer/data/lightmap_bc7.h
new file mode 100644
index 0000000000000000000000000000000000000000..adc7109301c14740a5db9b42d62d3b9ac4229b25
--- /dev/null
+++ b/src/common/rendering/hwrenderer/data/lightmap_bc7.h
@@ -0,0 +1,11 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+// Decode the complete standard BC7 block grid to tightly packed RGBA8. Output
+// is committed only after validating the source extent and decoding all blocks.
+bool DecodeBC7Lightmap(const void* source, size_t sourceBytes, uint32_t width, uint32_t height,
+	std::vector<uint8_t>& rgba, std::string& error);
diff --git a/src/common/rendering/hwrenderer/data/lightmap_data.cpp b/src/common/rendering/hwrenderer/data/lightmap_data.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..033d97b400ac3af39bb9439598607c18b2a8c7c9
--- /dev/null
+++ b/src/common/rendering/hwrenderer/data/lightmap_data.cpp
@@ -0,0 +1,295 @@
+#include "lightmap_data.h"
+#include <cstring>
+#include <limits>
+#include <utility>
+
+ELightmapChecksumResult CheckLightmapChecksum(uint32_t version,
+	const uint8_t stored[16], const uint8_t expected[16], bool useChecksum)
+{
+	if (version < 5) return ELightmapChecksumResult::NotChecked;
+	if (std::memcmp(stored, expected, 16) == 0) return ELightmapChecksumResult::Match;
+	return useChecksum ? ELightmapChecksumResult::MismatchRejected : ELightmapChecksumResult::MismatchIgnored;
+}
+
+namespace
+{
+struct Reader
+{
+	const uint8_t* Bytes;
+	size_t Length, Position = 0;
+	FString& Error;
+	FileSys::FileReader* Stream = nullptr;
+	const FLightmapImageSink* ImageSink = nullptr;
+	const uint8_t* ExpectedChecksum = nullptr;
+	ELightmapChecksumResult* ChecksumResult = nullptr;
+	bool UseChecksum = false;
+
+	bool Read(void* out, size_t size)
+	{
+		if (size > Length - Position)
+		{
+			Error.Format("Truncated LIGHTMAP at byte %zu", Position);
+			return false;
+		}
+		if (size)
+		{
+			if (Stream)
+			{
+				if (Stream->Read(out, size) != ptrdiff_t(size))
+				{
+					Error.Format("Truncated LIGHTMAP at byte %zu", Position);
+					return false;
+				}
+			}
+			else std::memcpy(out, Bytes + Position, size);
+		}
+		Position += size;
+		return true;
+	}
+	bool U8(uint8_t& out) { return Read(&out, 1); }
+	bool U16(uint16_t& out)
+	{
+		uint8_t b[2];
+		if (!Read(b, 2)) return false;
+		out = uint16_t(b[0]) | (uint16_t(b[1]) << 8);
+		return true;
+	}
+	bool U32(uint32_t& out)
+	{
+		uint8_t b[4];
+		if (!Read(b, 4)) return false;
+		out = uint32_t(b[0]) | (uint32_t(b[1]) << 8) |
+			(uint32_t(b[2]) << 16) | (uint32_t(b[3]) << 24);
+		return true;
+	}
+	bool Float(float& out)
+	{
+		uint32_t bits;
+		if (!U32(bits)) return false;
+		std::memcpy(&out, &bits, 4);
+		return true;
+	}
+	bool Count(uint32_t count, size_t stride)
+	{
+		if (count > (Length - Position) / stride)
+		{
+			Error.Format("Invalid LIGHTMAP count at byte %zu", Position);
+			return false;
+		}
+		return true;
+	}
+	bool TextureSize(uint16_t width, uint16_t height, uint32_t layers, bool compressed, uint32_t& size)
+	{
+		uint64_t n = compressed ? uint64_t(width / 4) * (height / 4) * layers * 16 :
+			uint64_t(width) * height * layers * 4;
+		if (n > std::numeric_limits<uint32_t>::max() || !Count(uint32_t(n), 1))
+		{
+			Error = "Invalid LIGHTMAP texture size";
+			return false;
+		}
+		size = uint32_t(n);
+		return true;
+	}
+	bool PixelArray(FLightmapFilePixels& pixels, uint32_t size, uint16_t width,
+		uint16_t height, uint32_t layers, bool compressed, bool groupImage, uint32_t imageIndex)
+	{
+		if (!Count(size, 1)) return false;
+		pixels.Size = size;
+		if (!Stream)
+		{
+			pixels.Bytes = size ? Bytes + Position : nullptr;
+			Position += size;
+			return true;
+		}
+		if (!layers || size % layers) { Error = "Invalid LIGHTMAP image layers"; return false; }
+		const uint32_t sliceSize = size / layers;
+		TArray<uint8_t> temporary;
+		auto& storage = groupImage ? temporary : pixels.Owned;
+		storage.Resize(size);
+		if (!Read(storage.Data(), size)) return false;
+		for (uint32_t i = 0; i < layers; ++i)
+			if (!(*ImageSink)(groupImage, imageIndex + i, width, height, compressed,
+				storage.Data() + size_t(i) * sliceSize, Error)) return false;
+		pixels.Bytes = groupImage ? nullptr : pixels.Owned.Data();
+		return true;
+	}
+	bool Mesh(FLightmapFileLayer& layer, uint32_t version)
+	{
+		if (!U16(layer.Width) || !U16(layer.Height)) return false;
+		if (version < 2) return true;
+		if (!U32(layer.DeclaredVertices) || !U32(layer.DeclaredIndices)) return false;
+		if (!layer.DeclaredVertices || !layer.DeclaredIndices) return true;
+		if (!Count(layer.DeclaredVertices, 24)) return false;
+		layer.Vertices.Resize(layer.DeclaredVertices);
+		for (auto& v : layer.Vertices)
+		{
+			if (!Float(v.X) || !Float(v.Y) || !Float(v.Z) || !Float(v.U) || !Float(v.V) || !U32(v.Color)) return false;
+		}
+		if (!Count(layer.DeclaredIndices, 4)) return false;
+		layer.Indices.Resize(layer.DeclaredIndices);
+		for (auto& value : layer.Indices) if (!U32(value)) return false;
+		return true;
+	}
+};
+}
+
+static bool DecodeLightmapReader(Reader& r, FLightmapFileData& decoded,
+	size_t& consumed, FString& error, bool strictFooter)
+{
+	consumed = 0;
+	error = "";
+	FLightmapFileData data;
+	uint32_t magic;
+	if (!r.U32(magic)) return false;
+	data.Magic = magic;
+	data.Version = magic & 255;
+	if ((magic & 0x5e1ac000) != 0x5e1ac000 || data.Version > 6)
+	{
+		error = "Unsupported LIGHTMAP magic/version";
+		return false;
+	}
+	if (data.Version >= 5 && !r.Read(data.Checksum, 16)) return false;
+	if (r.ExpectedChecksum && r.ChecksumResult)
+	{
+		*r.ChecksumResult = CheckLightmapChecksum(data.Version, data.Checksum,
+			r.ExpectedChecksum, r.UseChecksum);
+		if (*r.ChecksumResult == ELightmapChecksumResult::MismatchRejected)
+		{
+			error = "LIGHTMAP checksum mismatch";
+			return false;
+		}
+	}
+	uint16_t layers, groups;
+	uint32_t surfaces, texCoords, probes, heavy = 0, sectors = 0;
+	if (!r.U16(data.Width) || !r.U16(data.Height) || !r.U16(layers) || !r.U16(groups) ||
+		!r.U32(surfaces) || !r.U32(texCoords) || !r.U32(probes)) return false;
+	if (data.Version >= 4 && !r.U32(heavy)) return false;
+	if (data.Version >= 3 && !r.U32(sectors)) return false;
+	if (!r.U32(data.SubsectorCount) || !r.U32(data.CellSize)) return false;
+	uint8_t compressed = 0;
+	if (data.Version >= 6 && !r.U8(compressed)) return false;
+	data.Compressed = compressed != 0;
+	uint32_t pixelBytes;
+	if (!r.TextureSize(data.Width, data.Height, layers, data.Compressed, pixelBytes)) return false;
+	if (!surfaces || !texCoords || !pixelBytes)
+	{
+		error = "Empty LIGHTMAP surface/coordinate/texture payload";
+		return false;
+	}
+	if (!r.Count(probes, 89)) return false;
+	data.Probes.Resize(probes);
+	for (auto& p : data.Probes)
+	{
+		p = {};
+		if (!r.Float(p.X) || !r.Float(p.Y) || !r.Float(p.Z) ||
+			!r.Float(p.Red) || !r.Float(p.Green) || !r.Float(p.Blue) || !r.U8(p.Count)) return false;
+		if (p.Count > 4) { error = "Invalid LIGHTMAP probe sample count"; return false; }
+		for (auto& c : p.Contributions)
+			if (!r.U32(c.Group) || !r.Float(c.Red) || !r.Float(c.Green) || !r.Float(c.Blue)) return false;
+	}
+	if (!r.Count(heavy, 129)) return false;
+	data.HeavyProbes.Resize(heavy);
+	for (auto& p : data.HeavyProbes)
+	{
+		p = {};
+		uint32_t thing;
+		if (!r.Float(p.X) || !r.Float(p.Y) || !r.Float(p.Z) || !r.U32(thing) || !r.U8(p.Count)) return false;
+		std::memcpy(&p.ThingIndex, &thing, 4);
+		if (p.Count > 4) { error = "Invalid LIGHTMAP heavy sample count"; return false; }
+		for (auto& c : p.Contributions)
+		{
+			if (!r.Float(c.Red) || !r.Float(c.Green) || !r.Float(c.Blue)) return false;
+			for (auto& value : c.Direction) if (!r.Float(value)) return false;
+			if (!r.U32(c.Group)) return false;
+		}
+	}
+	if (!r.Count(surfaces, data.Version >= 2 ? 24 : 20)) return false;
+	data.Surfaces.Resize(surfaces);
+	for (auto& s : data.Surfaces)
+	{
+		if (!r.U32(s.Type) || !r.U32(s.SideIdOrSubsector)) return false;
+		if (data.Version >= 2 && !r.U32(s.Sector)) return false;
+		if (!r.U32(s.ControlSector) || !r.U32(s.Texture) || !r.U32(s.FirstTexCoord)) return false;
+		if (s.Texture >= layers || s.FirstTexCoord >= texCoords)
+		{
+			error = "Invalid LIGHTMAP surface texture/coordinate reference";
+			return false;
+		}
+	}
+	if (!r.Count(texCoords, 8) || texCoords > std::numeric_limits<uint32_t>::max() / 2) return false;
+	data.TexCoords.Resize(texCoords * 2);
+	for (auto& value : data.TexCoords) if (!r.Float(value)) return false;
+	if (!r.Count(layers, data.Version >= 2 ? 12 : 4)) return false;
+	data.Layers.Resize(layers);
+	for (auto& layer : data.Layers) if (!r.Mesh(layer, data.Version)) return false;
+	if (!r.PixelArray(data.Pixels, pixelBytes, data.Width, data.Height, layers, data.Compressed, false, 0)) return false;
+	if (!r.Count(groups, 4)) return false;
+	data.GroupTextures.Resize(groups);
+	uint32_t groupIndex = 0;
+	for (auto& group : data.GroupTextures)
+	{
+		if (!r.U16(group.Width) || !r.U16(group.Height) ||
+			!r.TextureSize(group.Width, group.Height, 1, data.Compressed, pixelBytes) ||
+			!r.PixelArray(group.Pixels, pixelBytes, group.Width, group.Height, 1, data.Compressed, true, groupIndex++)) return false;
+	}
+	if (!r.Count(sectors, 8)) return false;
+	data.Sectors.Resize(sectors);
+	for (auto& sector : data.Sectors)
+	{
+		if (!r.U32(sector.Index)) return false;
+		for (auto& updates : sector.Updates)
+		{
+			uint16_t count;
+			if (!r.U16(count) || !r.Count(count, 14)) return false;
+			updates.Resize(count);
+			for (auto& update : updates)
+			{
+				for (auto& word : update.Words)
+				{
+					uint16_t bits;
+					if (!r.U16(bits)) return false;
+					std::memcpy(&word, &bits, 2);
+				}
+				for (auto& value : update.Values) if (!r.U32(value)) return false;
+			}
+		}
+	}
+	if (data.Version >= 3)
+	{
+		uint32_t footer;
+		if (!r.U32(footer)) return false;
+		if (footer != 0x900d900d)
+		{
+			if (strictFooter) { error = "Invalid LIGHTMAP footer"; return false; }
+			data.FooterMismatch = true; // Owned live engine warns and continues.
+		}
+	}
+	consumed = r.Position;
+	decoded = std::move(data);
+	return true;
+}
+
+bool DecodeLightmapData(const void* bytes, size_t length,
+	FLightmapFileData& decoded, size_t& consumed, FString& error)
+{
+	consumed = 0;
+	error = "";
+	if (!bytes && length) { error = "Missing LIGHTMAP buffer"; return false; }
+	Reader reader{static_cast<const uint8_t*>(bytes), length, 0, error};
+	return DecodeLightmapReader(reader, decoded, consumed, error, true);
+}
+
+bool DecodeLightmapStream(FileSys::FileReader& input, const uint8_t expectedChecksum[16],
+	bool useChecksum, const FLightmapImageSink& imageSink, FLightmapFileData& decoded,
+	ELightmapChecksumResult& checksumResult, FString& error)
+{
+	checksumResult = ELightmapChecksumResult::NotChecked;
+	Reader reader{nullptr, std::numeric_limits<size_t>::max(), 0, error};
+	reader.Stream = &input;
+	reader.ImageSink = &imageSink;
+	reader.ExpectedChecksum = expectedChecksum;
+	reader.ChecksumResult = &checksumResult;
+	reader.UseChecksum = useChecksum;
+	size_t consumed = 0;
+	return DecodeLightmapReader(reader, decoded, consumed, error, false);
+}
