+};
+static_assert(sizeof(FLightGroupFileVertex) == 24);
+static_assert(offsetof(FLightGroupFileVertex, U) == 12);
+static_assert(offsetof(FLightGroupFileVertex, Color) == 20);
+
+struct FLightGroupFileMesh
+{
+	// These words are preserved without inventing renderer meaning before all
+	// native consumers have been attributed.
