+#include "v_video.h"
+#include "lightmap_geometry.h"
+
+FLightmapGeometryBuffer::FLightmapGeometryBuffer(DFrameBuffer& device)
+	: mVertices(device.CreateVertexBuffer()), mIndices(device.CreateIndexBuffer())
+{
+	static const FVertexBufferAttribute format[] = {
+		{ 0, VATTR_VERTEX, VFmt_Float3, (int)offsetof(FLightGroupFileVertex, X) },
+		{ 0, VATTR_TEXCOORD, VFmt_Float2, (int)offsetof(FLightGroupFileVertex, U) },
+		{ 0, VATTR_COLOR, VFmt_Byte4, (int)offsetof(FLightGroupFileVertex, Color) }
+	};
+	mVertices->SetFormat(1, 3, sizeof(FLightGroupFileVertex), format);
+}
+
+void FLightmapGeometryBuffer::Upload(const TArray<FLightGroupFileVertex>& vertices, const TArray<uint32_t>& indices)
+{
+	// The owned loader passes usage 1. Its actual GLBuffer::SetData branch
+	// selects GL_STREAM_DRAW, matching BufferUsageType::Stream in this tree.
+	mVertices->SetData(vertices.Size() * sizeof(FLightGroupFileVertex), vertices.Data(), BufferUsageType::Stream);
+	mIndices->SetData(indices.Size() * sizeof(uint32_t), indices.Data(), BufferUsageType::Stream);
+}
