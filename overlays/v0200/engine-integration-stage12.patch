diff --git a/src/private_audiofx_audit.cpp b/src/private_audiofx_audit.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..90ec3d488480952a64b6d1aa7ed2c3615cf37b1a
--- /dev/null
+++ b/src/private_audiofx_audit.cpp
@@ -0,0 +1,53 @@
+// Private CPU parser entry. Does not initialize GameMain, audio, input, config,
+// a renderer, or the game loop. The caller must supply an explicit fixture file.
+#include "s_audiofx.h"
+#include "sc_man.h"
+#include <cstdio>
+#include <exception>
+
+int RunPrivateAudioFXAudit(const char* path, const char* nextPath, bool nonFatal)
+{
+	try
+	{
+		FScanner sc;
+		if (!sc.OpenFile(path))
+		{
+			std::fprintf(stdout, "AUDIOFX_AUDIT_OPEN_FAILED\n");
+			return 3;
+		}
+		FSoundEffectLibrary library;
+		sc.SetNoFatalErrors(nonFatal);
+		library.Parse(sc);
+		if (nextPath)
+		{
+			FString firstName = library.GetDefinitions().Size() ? library.GetDefinitions()[0].Name : "";
+			FScanner next;
+			if (!next.OpenFile(nextPath)) return 3;
+			next.SetNoFatalErrors(nonFatal);
+			library.Parse(next);
+			std::fprintf(stdout, "AUDIOFX_AUDIT_PREVIOUS_NAME_INDEX %d\n", library.Find(firstName));
+		}
+		const auto& definitions = library.GetDefinitions();
+		std::fprintf(stdout, "AUDIOFX_AUDIT_DEFINITIONS %u\n", definitions.Size());
+		for (unsigned i = 0; i < definitions.Size(); ++i)
+		{
+			const auto& definition = definitions[i];
+			if (library.Find(definition.Name) != int(i)) return 4;
+			std::fprintf(stdout, "AUDIOFX_AUDIT_DEFINITION %u %u\n", i, definition.Stages.Size());
+			for (const auto& stage : definition.Stages)
+			{
+				std::fprintf(stdout, "AUDIOFX_AUDIT_STAGE %d %.9g %u %u\n", stage.Type, double(stage.Gain), stage.IntParameters.Size(), stage.FloatParameters.Size());
+				for (const auto& p : stage.IntParameters)
+					std::fprintf(stdout, "AUDIOFX_AUDIT_INT %d %d\n", p.Property, p.Value);
+				for (const auto& p : stage.FloatParameters)
+					std::fprintf(stdout, "AUDIOFX_AUDIT_FLOAT %d %.9g\n", p.Property, double(p.Value));
+			}
+		}
+		return 0;
+	}
+	catch (const std::exception& error)
+	{
+		std::fprintf(stdout, "AUDIOFX_AUDIT_REJECTED %s\n", error.what());
+		return 5;
+	}
+}
diff --git a/src/private_audiofx_backend_audit.cpp b/src/private_audiofx_backend_audit.cpp
