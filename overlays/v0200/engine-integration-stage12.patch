diff --git a/src/common/rendering/hwrenderer/data/lighting_probe_data.cpp b/src/common/rendering/hwrenderer/data/lighting_probe_data.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..ce3651a8b6f15ba0e40847d61ff1dd9daf1d1f8c
--- /dev/null
+++ b/src/common/rendering/hwrenderer/data/lighting_probe_data.cpp
@@ -0,0 +1,98 @@
+// Reference-backed CPU state/evaluation component. No unfinished native API or
+// renderer fallback is registered here; map, save and shader binding follow later.
+#include "lighting_probe_data.h"
+
+namespace
+{
+uint32_t LowConvertedByte(float value)
+{
+	// Native cvttss2si returns INT_MIN for NaN/out-of-range; its low byte is 0.
+	// Avoid undefined C++ conversions while preserving that observed byte result.
+	if (!(value >= -2147483648.f && value < 2147483648.f)) return 0;
+	return uint32_t(int32_t(value)) & 255u;
+}
+
+void UpdatePackedColor(FLightGroupProbeState& state)
+{
+	uint32_t r=LowConvertedByte((state.Intensity*state.Tint[0])*255.f);
+	uint32_t g=LowConvertedByte((state.Intensity*state.Tint[1])*255.f);
+	uint32_t b=LowConvertedByte((state.Intensity*state.Tint[2])*255.f);
+	state.PackedColor=0xff000000u | (r<<16) | (g<<8) | b;
+}
+}
+
+void SetLightGroupActive(FLightGroupProbeState& state, bool active, int updateGeneration)
+{
+	if (state.Active != active)
+	{
+		state.Active=active;
+		state.ChangedAt=updateGeneration;
+	}
+}
+
+void SetLightGroupIntensity(FLightGroupProbeState& state, double intensity, int updateGeneration)
+{
+	float value=float(intensity);
+	if (state.Intensity != value)
+	{
+		state.Intensity=value;
+		UpdatePackedColor(state);
+		state.ChangedAt=updateGeneration;
+	}
+}
+
+void SetLightGroupTint(FLightGroupProbeState& state, const int args[3], int updateGeneration)
+{
+	float rgb[3]={float(args[0])/255.f,float(args[1])/255.f,float(args[2])/255.f};
+	if (state.Tint[0] != rgb[0] || state.Tint[1] != rgb[1] || state.Tint[2] != rgb[2])
+	{
+		for (unsigned i=0;i<3;++i) state.Tint[i]=rgb[i];
+		UpdatePackedColor(state);
+		state.ChangedAt=updateGeneration;
+	}
+}
+
+bool EvaluateLightProbe(const FLightProbeFileData& probe, const TArray<FLightGroupProbeState>& groups, float out[3])
+{
+	if (probe.Count>4) return false;
+	for (unsigned i=0;i<probe.Count;++i)
+		if (probe.Contributions[i].Group>=groups.Size()) return false;
+	out[0]=probe.Red; out[1]=probe.Green; out[2]=probe.Blue;
+	for (unsigned i=0;i<probe.Count;++i)
+	{
+		const auto& sample=probe.Contributions[i];
+		const auto& group=groups[sample.Group];
+		if (!group.Active) continue;
+		out[0]+=(sample.Red*group.Tint[0])*group.Intensity;
+		out[1]+=(sample.Green*group.Tint[1])*group.Intensity;
+		out[2]+=(sample.Blue*group.Tint[2])*group.Intensity;
+	}
+	return true;
+}
+
+bool EvaluateHeavyProbe(const FHeavyProbeFileData& probe, const TArray<FLightGroupProbeState>& groups, FHeavyProbeEvaluatedSample out[4])
+{
+	if (probe.Count>4) return false;
+	for (unsigned i=0;i<probe.Count;++i)
+		if (probe.Contributions[i].Group>=groups.Size()) return false;
+	for (unsigned i=0;i<probe.Count;++i)
+	{
+		const auto& sample=probe.Contributions[i];
+		const auto& group=groups[sample.Group];
+		if (!group.Active && sample.Group!=0)
+		{
+			out[i].Color[0]=out[i].Color[1]=out[i].Color[2]=0.f;
+			out[i].Color[3]=1.f;
+		}
+		else
+		{
+			out[i].Color[0]=(sample.Red*group.Tint[0])*group.Intensity;
+			out[i].Color[1]=(sample.Green*group.Tint[1])*group.Intensity;
+			out[i].Color[2]=(sample.Blue*group.Tint[2])*group.Intensity;
+			out[i].Color[3]=group.Intensity;
+		}
+		for (unsigned axis=0;axis<3;++axis) out[i].Direction[axis]=sample.Direction[axis];
+		out[i].Direction[3]=1.f;
+	}
+	return true;
+}
