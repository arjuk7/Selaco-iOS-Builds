+
+int RunPrivateLightmapDataAudit(const char* mappingName, const char* mappingLength)
+{
+	try
+	{
+		struct Mapping
+		{
+			HANDLE Handle = nullptr;
+			const void* View = nullptr;
+			~Mapping() { if (View) UnmapViewOfFile(View); if (Handle) CloseHandle(Handle); }
+		} mapping;
+		std::vector<unsigned char> bytes;
+		const void* input = nullptr;
+		size_t inputLength = 0;
+		if (mappingName)
+		{
+			constexpr char prefix[] = "Local\\SelacoPrivateLightmap-";
+			if (std::strncmp(mappingName, prefix, sizeof(prefix)-1)) return 3;
+			if (!mappingLength) return 3;
+			char* end = nullptr;
+			errno = 0;
+			auto size = std::strtoull(mappingLength, &end, 10);
+			if (errno || !end || *end || !size || size > 2ull*1024*1024*1024) return 3;
+			mapping.Handle = OpenFileMappingA(FILE_MAP_READ, FALSE, mappingName);
+			if (!mapping.Handle) return 3;
+			mapping.View = MapViewOfFile(mapping.Handle, FILE_MAP_READ, 0, 0, size_t(size));
+			if (!mapping.View) return 3;
+			input = mapping.View;
+			inputLength = size_t(size);
+		}
+		else
+		{
+			_setmode(_fileno(stdin), _O_BINARY);
+			unsigned char block[65536];
+			for (;;)
+			{
+				auto n = std::fread(block, 1, sizeof(block), stdin);
+				if (bytes.size() + n > 512u*1024*1024) return 3;
+				bytes.insert(bytes.end(), block, block+n);
+				if (n < sizeof(block)) break;
+			}
+			if (std::ferror(stdin)) return 3;
+			input = bytes.data();
+			inputLength = bytes.size();
+		}
+		FLightmapFileData data;
+		FString error;
+		size_t consumed;
+		if (!DecodeLightmapData(input, inputLength, data, consumed, error))
+		{
+			std::fprintf(stdout, "LIGHTMAP_AUDIT_REJECTED %s\n", error.GetChars());
+			return 5;
+		}
+		auto wire = Reencode(data);
+		std::fprintf(stdout, "LIGHTMAP_AUDIT_RESULT %u %zu %zu %zu %08x %u %u %u %u %u %u %u %u %u %u %u %u\n",
+			data.Version, consumed, inputLength, wire.Size, wire.CRC, data.Width, data.Height, data.Layers.Size(),
+			data.GroupTextures.Size(), data.Surfaces.Size(), data.TexCoords.Size()/2, data.Probes.Size(), data.HeavyProbes.Size(),
+			data.Sectors.Size(), data.SubsectorCount, data.CellSize, unsigned(data.Compressed));
+		WireDigest probes, heavy;
+		if (data.Probes.Size()) probes.Bytes(&data.Probes[0], data.Probes.Size()*sizeof(FLightProbeFileData));
+		if (data.HeavyProbes.Size()) heavy.Bytes(&data.HeavyProbes[0], data.HeavyProbes.Size()*sizeof(FHeavyProbeFileData));
+		std::fprintf(stdout, "LIGHTMAP_AUDIT_PROBES %08x %08x\n", probes.CRC, heavy.CRC);
+		return 0;
+	}
+	catch (const std::exception& error)
+	{
+		std::fprintf(stdout, "LIGHTMAP_AUDIT_EXCEPTION %s\n", error.what());
+		return 6;
+	}
+}
