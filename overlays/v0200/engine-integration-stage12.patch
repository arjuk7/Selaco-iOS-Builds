@@ -0,0 +1,64 @@
+// Private binary-input entry: no GameMain, filesystem, graphics or game data writes.
+#include "lightgroup_data.h"
+#include "miniz.h"
+#include <cstdio>
+#include <vector>
+#include <exception>
+#include <fcntl.h>
+#include <io.h>
+
+namespace
+{
+unsigned Checksum(const void* data, size_t size)
+{
+	return unsigned(mz_crc32(0, static_cast<const unsigned char*>(data), size));
+}
+}
+
+int RunPrivateLightGroupDataAudit()
+{
+	try
+	{
+		_setmode(_fileno(stdin), _O_BINARY);
+		std::vector<unsigned char> bytes;
+		unsigned char block[65536];
+		for (;;)
+		{
+			auto read = std::fread(block, 1, sizeof(block), stdin);
+			bytes.insert(bytes.end(), block, block + read);
+			if (read < sizeof(block)) break;
+		}
+		if (std::ferror(stdin)) return 3;
+		FLightGroupFileData data;
+		FString error;
+		size_t consumed;
+		if (!DecodeLightGroupData(bytes.data(), bytes.size(), data, consumed, error))
+		{
+			std::fprintf(stdout, "LIGHTGROUP_AUDIT_REJECTED %s\n", error.GetChars());
+			return 5;
+		}
+		std::fprintf(stdout, "LIGHTGROUP_AUDIT_RESULT %u %u %u %zu %zu\n", data.Version, data.Meshes.Size(), data.Groups.Size(), consumed, bytes.size());
+		for (unsigned i = 0; i < data.Meshes.Size(); ++i)
+		{
+			const auto& mesh = data.Meshes[i];
+			const void* vertices = mesh.Vertices.Size() ? &mesh.Vertices[0] : nullptr;
+			const void* indices = mesh.Indices.Size() ? &mesh.Indices[0] : nullptr;
+			std::fprintf(stdout, "LIGHTGROUP_AUDIT_MESH %u %d %d %d %u %u %08x %08x\n", i,
+				mesh.HeaderWords[0], mesh.HeaderWords[1], mesh.HeaderWords[2], mesh.Vertices.Size(), mesh.Indices.Size(),
+				Checksum(vertices, mesh.Vertices.Size()*sizeof(FLightGroupFileVertex)), Checksum(indices, mesh.Indices.Size()*4));
+		}
+		for (unsigned i = 0; i < data.Groups.Size(); ++i)
+		{
+			const auto& group = data.Groups[i];
+			const void* references = group.MeshReferences.Size() ? &group.MeshReferences[0] : nullptr;
+			std::fprintf(stdout, "LIGHTGROUP_AUDIT_GROUP %u %u %08x %08x %u %08x\n", i, unsigned(group.HeaderWord),
+				Checksum(group.VectorA,12), Checksum(group.VectorB,12), group.MeshReferences.Size(), Checksum(references,group.MeshReferences.Size()*4));
+		}
+		return 0;
+	}
+	catch (const std::exception& error)
+	{
+		std::fprintf(stdout, "LIGHTGROUP_AUDIT_EXCEPTION %s\n", error.what());
+		return 6;
+	}
+}
diff --git a/src/private_lighting_map_open_audit.cpp b/src/private_lighting_map_open_audit.cpp
