+// Owned-reference native ABI: self and filePath are both FString pointers.
+// No filesystem access is granted unless the caller explicitly opts in.
+static int StringReadIn(FString* self, const FString* filePath)
+{
+	if (!Args->CheckParm("-UNSAFE_ALLOW_FILESYSTEM_ACCESS"))
+		ThrowAbortException(X_OTHER, "String.ReadIn is unavailable unless the game is launched with -UNSAFE_ALLOW_FILESYSTEM_ACCESS");
+	if (filePath == nullptr || filePath->IsEmpty())
+		ThrowAbortException(X_OTHER, "String.ReadIn requires a valid file path.");
+	FString fullPath;
+	fullPath.Format("%s/%s", progdir.GetChars(), filePath->GetChars());
+	if (!ValidateScriptFilePath(fullPath.GetChars(), progdir.GetChars(), true))
+	{
+		Printf("\x1cGFailed to read from %s\n", std::filesystem::weakly_canonical(fullPath.GetChars()).string().c_str());
+		return 0;
+	}
+	auto file = fopen(fullPath.GetChars(), "rb");
+	if (file == nullptr) return 0;
+	fseek(file, 0, SEEK_END);
+	const auto length = ftell(file);
+	fseek(file, 0, SEEK_SET);
+	const auto count = fread(self->LockNewBuffer(length), 1, length, file);
+	fclose(file);
+	// The reference keeps LockNewBuffer's locked string and returns success
+	// after an opened read, including a short read. Preserve that behavior.
+	Printf("\x1cVRead %zu bytes from %s\n", count, std::filesystem::weakly_canonical(fullPath.GetChars()).string().c_str());
+	return 1;
+}
+
+DEFINE_ACTION_FUNCTION_NATIVE(FStringStruct, ReadIn, StringReadIn)
+{
+	PARAM_SELF_STRUCT_PROLOGUE(FString);
+	PARAM_STRING(filePath);
+	ACTION_RETURN_BOOL(StringReadIn(self, &filePath));
+}
+
+static int StringWriteOut(FString* self, const FString* filePath)
+{
+	if (!Args->CheckParm("-UNSAFE_ALLOW_FILESYSTEM_ACCESS"))
+		ThrowAbortException(X_OTHER, "String.WriteOut is unavailable unless the game is launched with -UNSAFE_ALLOW_FILESYSTEM_ACCESS");
+	if (filePath == nullptr || filePath->IsEmpty())
+		ThrowAbortException(X_OTHER, "String.WriteOut requires a valid file path.");
+	FString fullPath;
+	fullPath.Format("%s/%s", progdir.GetChars(), filePath->GetChars());
+	if (!ValidateScriptFilePath(fullPath.GetChars(), progdir.GetChars(), false))
+	{
+		Printf("\x1cGFailed to write to %s\n", std::filesystem::weakly_canonical(fullPath.GetChars()).string().c_str());
+		return 0;
+	}
+	auto file = fopen(fullPath.GetChars(), "wb");
+	if (file == nullptr) return 0;
+	const auto count = fwrite(self->GetChars(), 1, self->Len(), file);
+	fclose(file);
+	Printf("\x1cVWrote %zu bytes to %s\n", count, std::filesystem::weakly_canonical(fullPath.GetChars()).string().c_str());
+	return count == self->Len();
+}
+
+DEFINE_ACTION_FUNCTION_NATIVE(FStringStruct, WriteOut, StringWriteOut)
+{
+	PARAM_SELF_STRUCT_PROLOGUE(FString);
+	PARAM_STRING(filePath);
+	ACTION_RETURN_BOOL(StringWriteOut(self, &filePath));
+}
