--- /dev/null
+++ b/src/common/rendering/hwrenderer/data/lightmap_queue_contract.h
@@ -0,0 +1,14 @@
+#pragma once
+
+// Shared queue operation for the level's sector-update records. The caller
+// resolves sector indices and applies the native map-version gate first.
+template<class SectorUpdate>
+void QueueLightmapSectorUpdate(SectorUpdate*& first, SectorUpdate*& last, SectorUpdate* update)
+{
+	if (!update || update->Index < 0 || update->Queued) return;
+	if (!first) first = update;
+	if (last) last->Next = update;
+	last = update;
+	last->Next = nullptr;
+	update->Queued = true;
+}
diff --git a/src/common/rendering/hwrenderer/data/lightmap_render_contract.h b/src/common/rendering/hwrenderer/data/lightmap_render_contract.h
new file mode 100644
index 0000000000000000000000000000000000000000..0d66325799191c3275eb9afde8449b25ab613a95
--- /dev/null
+++ b/src/common/rendering/hwrenderer/data/lightmap_render_contract.h
@@ -0,0 +1,38 @@
+#pragma once
+
+#include <cstdint>
+
+// The reference passes width/height as an eight-byte pair, independently of
+// the layer count. These are render-array dimensions, not source image pixels.
+struct FLightmapTextureSize
+{
+	int Width = 0, Height = 0;
+};
+static_assert(sizeof(FLightmapTextureSize) == 8);
+
+// Shared production operation sequences; the private CPU audit records these
+// same calls without creating a graphics context or replacing a game API.
+template<class GL>
+void InitializeLightmapArrayGL(GL& gl, unsigned& texture, FLightmapTextureSize size, int layers)
+{
+	auto active = gl.GetActiveTexture();
+	gl.SelectTextureUnit17();
+	if (!texture) gl.GenerateTexture(texture);
+	gl.BindArray(texture);
+	gl.AllocateRGBA8Array(size.Width, size.Height, layers);
+	gl.SetLinearMinification();
+	gl.SetLinearMagnification();
+	gl.RestoreActiveTexture(active);
+}
+
+template<class GL, class Callback>
+void RenderLightmapLayerGL(GL& gl, int layer, FLightmapTextureSize size, Callback&& callback)
+{
+	gl.StartOffscreen();
+	gl.ClearLastMaterial();
+	gl.AttachColorLayer(layer);
+	gl.DetachDepth();
+	gl.DetachStencil();
+	callback(size.Width, size.Height);
+	gl.EndOffscreen();
+}
