+void MapLoader::LoadLightGroups(MapData* map)
+{
+	// FLevelLocals is recycled. Release the preceding map's native resources.
+	Level->LightGroups.Reset();
+	Level->LightGroupGeometry.reset();
+	Level->LightGroupUpdateGeneration = 0;
+	if (!map->Size(ML_LIGHTGROUP)) return;
+
+	auto bytes = map->Read(ML_LIGHTGROUP);
+	FLightGroupFileData data;
+	size_t consumed = 0;
+	FString error;
+	if (!DecodeLightGroupData(bytes.Data(), bytes.Size(), data, consumed, error))
+	{
+		Printf(PRINT_HIGH, "LoadLightGroups: %s\n", error.GetChars());
+		return;
+	}
+
+	auto geometry = std::make_unique<FLightGroupRuntimeGeometry>();
+	geometry->Meshes.reserve(data.Meshes.Size());
+	for (const auto& mesh : data.Meshes)
+	{
+		FLightGroupRuntimeMesh runtime;
+		for (unsigned i = 0; i < 3; ++i) runtime.HeaderWords[i] = mesh.HeaderWords[i];
+		runtime.IndexCount = mesh.Indices.Size();
+		runtime.Geometry = std::make_unique<FLightmapGeometryBuffer>(*screen);
+		runtime.Geometry->Upload(mesh.Vertices, mesh.Indices);
+		geometry->Meshes.push_back(std::move(runtime));
+	}
+	Level->LightGroups.Resize(data.Groups.Size());
+	for (unsigned i = 0; i < data.Groups.Size(); ++i)
+	{
+		const auto& source = data.Groups[i];
+		auto& target = Level->LightGroups[i];
+		target = FLightGroupProbeState{};
+		target.Index = i;
+		target.HeaderWord = source.HeaderWord;
+		for (unsigned axis = 0; axis < 3; ++axis)
+		{
+			target.VectorA[axis] = source.VectorA[axis];
+			target.VectorB[axis] = source.VectorB[axis];
+		}
+		target.MeshReferences = std::move(data.Groups[i].MeshReferences);
+	}
+	Level->LightGroupGeometry = std::move(geometry);
+}
