+// Private map-opening check: only task-local synthetic WADs, before GameMain.
+#include "p_setup.h"
+#include "miniz.h"
+#include "filesystem.h"
+#include "lightmap_data.h"
+#include <cstdio>
+#include <memory>
+#include <exception>
+#include <cstring>
+#include <fcntl.h>
+#include <io.h>
+
+static_assert(ML_LIGHTMAP == 13 && ML_LIGHTGROUP == 14 && ML_LMCHECKSUM == 15);
+
+int RunPrivateLightingMapOpenAudit(const char* file)
+{
+	try
+	{
+		FString external("file:");
+		external += file;
+		std::unique_ptr<MapData> map(P_OpenMapData(external.GetChars(), false));
+		if (!map) return 5;
+		std::fprintf(stdout, "LIGHTING_MAP_OPEN %d %u %u %u\n", int(map->isText), map->Size(ML_LIGHTMAP),
+			map->Size(ML_LIGHTGROUP), map->Size(ML_LMCHECKSUM));
+		for (unsigned slot : {unsigned(ML_LIGHTMAP), unsigned(ML_LIGHTGROUP), unsigned(ML_LMCHECKSUM)})
+		{
+			auto bytes = map->Read(slot);
+			const unsigned char* p = bytes.Size() ? &bytes[0] : nullptr;
+			std::fprintf(stdout, "LIGHTING_MAP_SLOT %u %u %08x\n", slot, bytes.Size(),
+				unsigned(mz_crc32(0, p, bytes.Size())));
+		}
+		return 0;
+	}
+	catch (const std::exception& error)
+	{
+		std::fprintf(stdout, "LIGHTING_MAP_OPEN_EXCEPTION %s\n", error.what());
+		return 6;
+	}
+}
+
+int RunPrivateLightmapChecksumAudit()
+{
+	_setmode(_fileno(stdin), _O_BINARY);
+	uint8_t bytes[37];
+	if (std::fread(bytes,1,sizeof(bytes),stdin) != sizeof(bytes) || std::fgetc(stdin) != EOF) return 3;
+	uint32_t version = uint32_t(bytes[0]) | (uint32_t(bytes[1]) << 8) |
+		(uint32_t(bytes[2]) << 16) | (uint32_t(bytes[3]) << 24);
+	auto result = CheckLightmapChecksum(version, bytes+5, bytes+21, bytes[4] != 0);
+	std::fprintf(stdout, "LIGHTMAP_CHECKSUM %u\n", unsigned(result));
+	return 0;
+}
+
+int RunPrivateLightingOwnedMapAudit(const char* payload)
+{
+	try
+	{
+		if (!fileSystem.InitSingleFile(payload)) return 3;
+		char name[1024];
+		while (std::fgets(name,sizeof(name),stdin))
+		{
+			name[std::strcspn(name,"\r\n")] = 0;
+			if (!*name) continue;
+			std::unique_ptr<MapData> map(P_OpenMapData(name,false,0));
+			if (!map) return 5;
+			std::fprintf(stdout, "LIGHTING_OWNED_MAP %s %d\n", name, int(map->isText));
+			for (unsigned slot : {unsigned(ML_LIGHTMAP),unsigned(ML_LIGHTGROUP),unsigned(ML_LMCHECKSUM)})
+			{
+				auto bytes=map->Read(slot);
+				std::fprintf(stdout, "LIGHTING_OWNED_SLOT %u %u %08x\n", slot, bytes.Size(),
+					unsigned(mz_crc32(0,bytes.Size()?&bytes[0]:nullptr,bytes.Size())));
+			}
+		}
+		return std::ferror(stdin) ? 3 : 0;
+	}
+	catch (const std::exception& error)
+	{
+		std::fprintf(stdout, "LIGHTING_OWNED_EXCEPTION %s\n", error.what());
+		return 6;
+	}
+}
diff --git a/src/private_lighting_probe_audit.cpp b/src/private_lighting_probe_audit.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..56054399e1dcdf68b05b9dd2ff325a94bc55e8f8
--- /dev/null
+++ b/src/private_lighting_probe_audit.cpp
@@ -0,0 +1,69 @@
+#include "lighting_probe_data.h"
+#include <cstdio>
+#include <fcntl.h>
+#include <io.h>
+
+namespace
+{
+template<class T> bool Read(T& value) { return std::fread(&value,1,sizeof(value),stdin)==sizeof(value); }
+template<class T> void Write(const T& value) { std::fwrite(&value,1,sizeof(value),stdout); }
+}
+
+int RunPrivateLightingProbeAudit()
+{
+	_setmode(_fileno(stdin),_O_BINARY);
+	_setmode(_fileno(stdout),_O_BINARY);
+	uint32_t operation,count;
+	if (!Read(operation) || !Read(count) || count>32) return 3;
+	TArray<FLightGroupProbeState> groups;
+	groups.Resize(count);
+	for (auto& group:groups)
+	{
+		uint32_t active;
+		if (!Read(active) || !Read(group.Intensity) || !Read(group.Tint) || !Read(group.PackedColor) || !Read(group.ChangedAt)) return 3;
+		group.Active=active!=0;
+	}
+	if (operation<=2)
+	{
+		if (groups.Size()==0) return 5;
+		int mapTime;
+		if (operation==0)
+		{
+			uint32_t active;
+			if (!Read(active) || !Read(mapTime)) return 3;
+			SetLightGroupActive(groups[0],active!=0,mapTime);
+		}
+		else if (operation==1)
+		{
+			double intensity;
+			if (!Read(intensity) || !Read(mapTime)) return 3;
+			SetLightGroupIntensity(groups[0],intensity,mapTime);
+		}
+		else
+		{
+			int args[3];
+			if (!Read(args) || !Read(mapTime)) return 3;
+			SetLightGroupTint(groups[0],args,mapTime);
+		}
+		uint32_t active=groups[0].Active;
+		Write(active);Write(groups[0].Intensity);Write(groups[0].Tint);Write(groups[0].PackedColor);Write(groups[0].ChangedAt);
+	}
+	else if (operation==3)
+	{
+		FLightProbeFileData probe;
+		float result[3];
+		if (!Read(probe)) return 3;
+		if (!EvaluateLightProbe(probe,groups,result)) return 5;
+		Write(result);
+	}
+	else if (operation==4)
+	{
+		FHeavyProbeFileData probe;
+		FHeavyProbeEvaluatedSample result[4]={};
+		if (!Read(probe)) return 3;
+		if (!EvaluateHeavyProbe(probe,groups,result)) return 5;
+		Write(result);
+	}
+	else return 3;
+	return std::ferror(stdout) ? 3 : 0;
+}
diff --git a/src/private_lightmap_data_audit.cpp b/src/private_lightmap_data_audit.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..4a8aad0b887204da4cbf605e197b9e3298724bfa
--- /dev/null
+++ b/src/private_lightmap_data_audit.cpp
@@ -0,0 +1,172 @@
+// Private CPU/stdin component check; no GameMain or live map/renderer writes.
+#include "lightmap_data.h"
+#include "miniz.h"
+#include <cstdio>
+#include <cstring>
+#include <exception>
+#include <vector>
+#include <cstdlib>
+#include <cerrno>
+#include <fcntl.h>
+#include <io.h>
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+
+namespace
+{
+struct WireDigest
+{
+	unsigned CRC = 0;
+	size_t Size = 0;
+	void Bytes(const void* p, size_t n)
+	{
+		CRC = unsigned(mz_crc32(CRC, static_cast<const unsigned char*>(p), n));
+		Size += n;
+	}
+	void U8(uint8_t x) { Bytes(&x, 1); }
+	void U16(uint16_t x) { uint8_t b[2] = {uint8_t(x), uint8_t(x >> 8)}; Bytes(b, 2); }
+	void U32(uint32_t x)
+	{
+		uint8_t b[4] = {uint8_t(x), uint8_t(x >> 8), uint8_t(x >> 16), uint8_t(x >> 24)};
+		Bytes(b, 4);
+	}
+	void Float(float x) { uint32_t bits; std::memcpy(&bits, &x, 4); U32(bits); }
+	void Pixels(const FLightmapFilePixels& p) { if (p.Size) Bytes(p.Bytes, p.Size); }
+	void Vertex(const FLightGroupFileVertex& v)
+	{
+		Float(v.X); Float(v.Y); Float(v.Z); Float(v.U); Float(v.V); U32(v.Color);
+	}
+};
+
+WireDigest Reencode(const FLightmapFileData& d)
+{
+	WireDigest w;
+	w.U32(d.Magic);
+	if (d.Version >= 5) w.Bytes(d.Checksum, 16);
+	w.U16(d.Width); w.U16(d.Height); w.U16(uint16_t(d.Layers.Size())); w.U16(uint16_t(d.GroupTextures.Size()));
+	w.U32(d.Surfaces.Size()); w.U32(d.TexCoords.Size()/2); w.U32(d.Probes.Size());
+	if (d.Version >= 4) w.U32(d.HeavyProbes.Size());
+	if (d.Version >= 3) w.U32(d.Sectors.Size());
+	w.U32(d.SubsectorCount); w.U32(d.CellSize);
+	if (d.Version >= 6) w.U8(d.Compressed ? 1 : 0);
+	for (const auto& p : d.Probes)
+	{
+		w.Float(p.X); w.Float(p.Y); w.Float(p.Z); w.Float(p.Red); w.Float(p.Green); w.Float(p.Blue); w.U8(p.Count);
+		for (const auto& c : p.Contributions) { w.U32(c.Group); w.Float(c.Red); w.Float(c.Green); w.Float(c.Blue); }
+	}
+	for (const auto& p : d.HeavyProbes)
+	{
+		w.Float(p.X); w.Float(p.Y); w.Float(p.Z); w.U32(uint32_t(p.ThingIndex)); w.U8(p.Count);
+		for (const auto& c : p.Contributions)
+		{
+			w.Float(c.Red); w.Float(c.Green); w.Float(c.Blue);
+			for (auto x : c.Direction) w.Float(x);
+			w.U32(c.Group);
+		}
+	}
+	for (const auto& s : d.Surfaces)
+	{
+		w.U32(s.Type); w.U32(s.SideIdOrSubsector);
+		if (d.Version >= 2) w.U32(s.Sector);
+		w.U32(s.ControlSector); w.U32(s.Texture); w.U32(s.FirstTexCoord);
+	}
+	for (auto x : d.TexCoords) w.Float(x);
+	for (const auto& l : d.Layers)
+	{
+		w.U16(l.Width); w.U16(l.Height);
+		if (d.Version >= 2)
+		{
+			w.U32(l.DeclaredVertices); w.U32(l.DeclaredIndices);
+			for (const auto& v : l.Vertices) w.Vertex(v);
+			for (auto i : l.Indices) w.U32(i);
+		}
+	}
+	w.Pixels(d.Pixels);
+	for (const auto& g : d.GroupTextures) { w.U16(g.Width); w.U16(g.Height); w.Pixels(g.Pixels); }
+	for (const auto& s : d.Sectors)
+	{
+		w.U32(s.Index);
+		for (const auto& list : s.Updates)
+		{
+			w.U16(uint16_t(list.Size()));
+			for (const auto& u : list)
+			{
+				for (auto x : u.Words) w.U16(uint16_t(x));
+				for (auto x : u.Values) w.U32(x);
+			}
+		}
+	}
+	if (d.Version >= 3) w.U32(0x900d900d);
+	return w;
+}
