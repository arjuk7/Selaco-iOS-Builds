diff --git a/src/common/scripting/interface/fsaccess_policy.h b/src/common/scripting/interface/fsaccess_policy.h
new file mode 100644
index 0000000000000000000000000000000000000000..731e1b6936ca5f795881caa4c499b3b692f59a47
--- /dev/null
+++ b/src/common/scripting/interface/fsaccess_policy.h
@@ -0,0 +1,17 @@
+#pragma once
+
+#include <algorithm>
+#include <filesystem>
+
+// Reconstructed from the owned engine's complete path-validation body at
+// 0x140541be0. The caller must first enforce the explicit filesystem opt-in.
+// Keep the throwing canonical/status operations and component comparison:
+// replacing this with a textual path prefix would change containment semantics.
+inline bool ValidateScriptFilePath(const char* filePath, const char* programDirectory, bool requireExisting)
+{
+	const auto root = std::filesystem::canonical(programDirectory);
+	const auto parent = std::filesystem::canonical(std::filesystem::path(filePath).parent_path());
+	if (!std::filesystem::exists(parent) || !std::filesystem::is_directory(parent)) return false;
+	if (requireExisting && !std::filesystem::exists(std::filesystem::canonical(filePath))) return false;
+	return std::mismatch(root.begin(), root.end(), parent.begin(), parent.end()).first == root.end();
+}
