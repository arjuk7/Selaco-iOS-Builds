diff --git a/src/common/audio/sound/s_audiofx_backend.h b/src/common/audio/sound/s_audiofx_backend.h
new file mode 100644
index 0000000000000000000000000000000000000000..1e29ad847847788838f59c1865e81efa32a8be47
--- /dev/null
+++ b/src/common/audio/sound/s_audiofx_backend.h
@@ -0,0 +1,87 @@
+#pragma once
+
+#include "s_audiofx.h"
+
+struct FSoundEffectSlots
+{
+	TArray<unsigned> WithoutEnvironment;
+	TArray<unsigned> WithEnvironment;
+};
+
+template<class Backend>
+void RouteSoundEffectSource(Backend& backend, unsigned source,
+	const TArray<FSoundEffectSlots>& effects, int effectIndex, bool noReverb,
+	unsigned environmentFilter, unsigned directFilter, bool clearRoomRolloff)
+{
+	if (effectIndex >= 0 && unsigned(effectIndex) < effects.Size())
+	{
+		const auto& effect = effects[effectIndex];
+		backend.SourceInt(source, 0x20005, directFilter);
+		if (clearRoomRolloff) backend.SourceFloat(source, 0x20008, 0.f);
+		backend.Source3Int(source, 0x20006, effect.WithoutEnvironment[0], 0, 0);
+		if (!noReverb)
+			backend.Source3Int(source, 0x20006, effect.WithEnvironment[0], 1, environmentFilter);
+		else
+			backend.Source3Int(source, 0x20006, 0, 1, 0);
+	}
+	else
+		backend.Source3Int(source, 0x20006, 0, 1, 0);
+}
+
+// A single implementation is used by the real OpenAL adapter and the private
+// CPU call-recording test. IDs and routing follow the owned native backend.
+template<class Backend>
+void BuildSoundEffectSlots(Backend& backend, const TArray<FNamedSoundEffect>& definitions,
+	TArray<FSoundEffectSlots>& compiled, TArray<unsigned>& allSlots,
+	TArray<unsigned>& allEffects, unsigned environmentSlot, unsigned& directFilter)
+{
+	for (const auto& definition : definitions)
+	{
+		FSoundEffectSlots slots;
+		unsigned previousWithout = unsigned(-1), previousWith = unsigned(-1);
+		for (const auto& stage : definition.Stages)
+		{
+			unsigned without = backend.NewSlot();
+			backend.CheckError();
+			allSlots.Push(without);
+			slots.WithoutEnvironment.Push(without);
+			unsigned effect = backend.NewEffect();
+			backend.CheckError();
+			allEffects.Push(effect);
+			backend.EffectInt(effect, 0x8001, stage.Type);
+			backend.CheckError();
+			for (const auto& parameter : stage.IntParameters)
+			{
+				backend.EffectInt(effect, parameter.Property, parameter.Value);
+				backend.CheckError();
+			}
+			for (const auto& parameter : stage.FloatParameters)
+			{
+				backend.EffectFloat(effect, parameter.Property, parameter.Value);
+				backend.CheckError();
+			}
+			backend.SlotInt(without, 1, effect);
+			backend.SlotFloat(without, 2, stage.Gain);
+			unsigned with = backend.NewSlot();
+			backend.SlotInt(with, 1, effect);
+			backend.SlotFloat(with, 2, stage.Gain);
+			allSlots.Push(with);
+			slots.WithEnvironment.Push(with);
+			if (previousWithout != unsigned(-1))
+			{
+				backend.SlotInt(previousWithout, 0x199c, without);
+				backend.SlotInt(previousWith, 0x199c, with);
+			}
+			previousWithout = without;
+			previousWith = with;
+			backend.CheckError();
+		}
+		if (previousWith != unsigned(-1) && environmentSlot != 0)
+			backend.SlotInt(previousWith, 0x199c, environmentSlot);
+		compiled.Push(std::move(slots));
+	}
+	directFilter = backend.NewFilter();
+	backend.FilterInt(directFilter, 0x8001, 1);
+	backend.FilterFloat(directFilter, 1, 0.f);
+	backend.FilterFloat(directFilter, 2, 0.f);
+}
