+{
+	if (format != 0 && format != 1) I_FatalError("Unsupported lightmap texture format %d", format);
+	int bytes = format == 1 ? (w / 4) * (h / 4) * 16 : w * h * 4;
+	if (buffer && format == 1 &&
+		(!fb->device->EnabledFeatures.Features.textureCompressionBC ||
+		!ImageBuilder().Format(VK_FORMAT_BC7_UNORM_BLOCK).Size(w, h)
+			.Usage(VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT)
+			.IsFormatSupported(fb->device.get(), 0)))
+	{
+		// Preserve the native compressed path where supported. A platform
+		// without BC7 uploads the exact decoded RGBA8 pixels instead; capability
+		// comes from the enabled feature set and genuine image-format query.
+		std::vector<uint8_t> rgba;
+		std::string error;
+		if (w <= 0 || h <= 0 || !DecodeBC7Lightmap(buffer, size_t(bytes), uint32_t(w), uint32_t(h), rgba, error))
+			I_FatalError("Cannot decode BC7 lightmap: %s", error.c_str());
+		CreateTexture(fb->GetCommands(), mImage.get(), w, h, 4, VK_FORMAT_R8G8B8A8_UNORM,
+			rgba.data(), 0, false, int(rgba.size()));
+		return 0;
+	}
+	VkFormat imageFormat = format == 1 ? VK_FORMAT_BC7_UNORM_BLOCK :
+		mTexelsize == 4 ? VK_FORMAT_B8G8R8A8_UNORM : VK_FORMAT_R8_UNORM;
+	if (buffer)
+		CreateTexture(fb->GetCommands(), mImage.get(), w, h, 4, imageFormat, buffer, 0, false, bytes);
+	return 0;
+}
