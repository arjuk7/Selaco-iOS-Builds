+#pragma once
+
+#include "lighting_probe_data.h"
+#include "lightgroup_data.h"
+#include "filesystem.h"
+#include <functional>
+
+struct FLightmapFileSurface
+{
+	uint32_t Type = 0, SideIdOrSubsector = 0, Sector = 0xffffffff;
+	uint32_t ControlSector = 0xffffffff, Texture = 0, FirstTexCoord = 0;
+};
+
+struct FLightmapFileLayer
+{
+	uint16_t Width = 0, Height = 0;
+	uint32_t DeclaredVertices = 0, DeclaredIndices = 0;
+	TArray<FLightGroupFileVertex> Vertices;
+	TArray<uint32_t> Indices;
+};
+
+struct FLightmapFilePixels
+{
+	const uint8_t* Bytes = nullptr;
+	uint32_t Size = 0;
+	TArray<uint8_t> Owned; // Live primary pixels only; memory-audit spans remain borrowed.
+};
+
+struct FLightmapFileGroupTexture
+{
+	uint16_t Width = 0, Height = 0;
+	FLightmapFilePixels Pixels;
+};
+
+struct FLightmapFileSectorUpdate
+{
+	int16_t Words[3] = {};
+	uint32_t Values[2] = {};
+};
+
+struct FLightmapFileSector
+{
+	uint32_t Index = 0;
+	TArray<FLightmapFileSectorUpdate> Updates[2];
+};
+
+struct FLightmapFileData
+{
+	uint32_t Magic = 0;
+	uint32_t Version = 0;
+	uint8_t Checksum[16] = {};
+	uint16_t Width = 0, Height = 0;
+	uint32_t SubsectorCount = 0, CellSize = 0;
+	bool Compressed = false;
+	bool FooterMismatch = false;
+	TArray<FLightProbeFileData> Probes;
+	TArray<FHeavyProbeFileData> HeavyProbes;
+	TArray<FLightmapFileSurface> Surfaces;
+	TArray<float> TexCoords;
+	TArray<FLightmapFileLayer> Layers;
+	FLightmapFilePixels Pixels;
+	TArray<FLightmapFileGroupTexture> GroupTextures;
+	TArray<FLightmapFileSector> Sectors;
+};
+
+// CPU staging only, after zlib decompression. Native magic/version and footer
+// are validated. Stored checksum is exposed for the separate map policy; this
+// function does not replace or choose the native -uselmchecksum behavior.
+// No mapthings, renderer objects, live level or script bindings are modified.
+// Pixel spans borrow input storage; the input must outlive the decoded result.
+bool DecodeLightmapData(const void* bytes, size_t length,
+	FLightmapFileData& decoded, size_t& consumed, FString& error);
+
+enum class ELightmapChecksumResult
+{
+	NotChecked, Match, MismatchIgnored, MismatchRejected
+};
+
+// Native comparison policy. The caller must supply the real -uselmchecksum
+// state and the checksum selected by MapData; there is no implicit opt-out.
+ELightmapChecksumResult CheckLightmapChecksum(uint32_t version,
+	const uint8_t stored[16], const uint8_t expected[16], bool useChecksum);
+
+// Sequential live path: primary pixels retain native ownership until framebuffer
+// initialization; each group image is uploaded and released before reading the
+// next. The checksum decision occurs immediately after the versioned header.
+using FLightmapImageSink = std::function<bool(bool groupImage, uint32_t index,
+	uint16_t width, uint16_t height, bool compressed, uint8_t* pixels, FString& error)>;
+bool DecodeLightmapStream(FileSys::FileReader& input, const uint8_t expectedChecksum[16],
+	bool useChecksum, const FLightmapImageSink& imageSink, FLightmapFileData& decoded,
+	ELightmapChecksumResult& checksumResult, FString& error);
