diff --git a/src/common/scripting/dap/Nodes/LocalScopeStateNode.cpp b/src/common/scripting/dap/Nodes/LocalScopeStateNode.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..c724ff68c868ae469d558860e3433c620329e63b
--- /dev/null
