@@ -0,0 +1,67 @@
+// Private recording adapter for the same builder/router used by real OpenAL.
+// Its call stream is replayed against an owned CPU loopback device by the test.
+#include "s_audiofx_backend.h"
+#include "s_loader.h"
+#include "sc_man.h"
+#include <cstddef>
+#include <cstdio>
+#include <exception>
+
+static_assert(offsetof(AudioQueuePlayInfo, effectIndex) == 0x50);
+static_assert(sizeof(AudioQueuePlayInfo) == 0x58);
+
+namespace
+{
+struct RecordingBackend
+{
+	unsigned NextSlot = 101, NextEffect = 1001, NextFilter = 2001;
+	void Emit(const char* op, unsigned id, int key=0, int value=0, int send=0, int filter=0, float floating=0)
+	{
+		std::fprintf(stdout, "AUDIOFX_BACKEND_CALL %s %u %d %d %d %d %.9g\n", op, id, key, value, send, filter, double(floating));
+	}
+	unsigned NewSlot() { auto id=NextSlot++; Emit("NewSlot", id); return id; }
+	unsigned NewEffect() { auto id=NextEffect++; Emit("NewEffect", id); return id; }
+	unsigned NewFilter() { auto id=NextFilter++; Emit("NewFilter", id); return id; }
+	void EffectInt(unsigned id,int key,int value) { Emit("EffectInt",id,key,value); }
+	void EffectFloat(unsigned id,int key,float value) { Emit("EffectFloat",id,key,0,0,0,value); }
+	void SlotInt(unsigned id,int key,int value) { Emit("SlotInt",id,key,value); }
+	void SlotFloat(unsigned id,int key,float value) { Emit("SlotFloat",id,key,0,0,0,value); }
+	void FilterInt(unsigned id,int key,int value) { Emit("FilterInt",id,key,value); }
+	void FilterFloat(unsigned id,int key,float value) { Emit("FilterFloat",id,key,0,0,0,value); }
+	void SourceInt(unsigned id,int key,int value) { Emit("SourceInt",id,key,value); }
+	void SourceFloat(unsigned id,int key,float value) { Emit("SourceFloat",id,key,0,0,0,value); }
+	void Source3Int(unsigned id,int key,int value,int send,int filter) { Emit("Source3Int",id,key,value,send,filter); }
+	void CheckError() { Emit("CheckError",0); }
+};
+}
+
+int RunPrivateAudioFXBackendAudit(const char* path)
+{
+	try
+	{
+		FScanner scanner;
+		if (!scanner.OpenFile(path)) return 3;
+		FSoundEffectLibrary library;
+		library.Parse(scanner);
+		RecordingBackend backend;
+		TArray<FSoundEffectSlots> compiled;
+		TArray<unsigned> slots,effects;
+		unsigned filter=0;
+		BuildSoundEffectSlots(backend,library.GetDefinitions(),compiled,slots,effects,9000,filter);
+		if (compiled.Size())
+		{
+			RouteSoundEffectSource(backend,9010,compiled,0,false,9001,filter,false);
+			RouteSoundEffectSource(backend,9011,compiled,0,true,9001,filter,true);
+			RouteSoundEffectSource(backend,9014,compiled,int(compiled.Size()-1),false,9001,filter,true);
+		}
+		RouteSoundEffectSource(backend,9012,compiled,-1,false,9001,filter,false);
+		RouteSoundEffectSource(backend,9013,compiled,int(compiled.Size()),false,9001,filter,true);
+		std::fprintf(stdout,"AUDIOFX_BACKEND_RESULT %u %u %u %u\n",compiled.Size(),slots.Size(),effects.Size(),filter);
+		return 0;
+	}
+	catch (const std::exception& error)
+	{
+		std::fprintf(stdout,"AUDIOFX_BACKEND_REJECTED %s\n",error.what());
+		return 5;
+	}
+}
