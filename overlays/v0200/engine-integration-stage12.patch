+#include "lightmap_texture.h"
+#include "textures.h"
+#include "gametexture.h"
+#include "hw_ihwtexture.h"
+
+std::unique_ptr<FGameTexture> CreateLightmapSourceTexture(uint8_t* pixels, int width, int height,
+	bool compressed, const char* name)
+{
+	RefCountedPtr<FTexture> texture(new FWrapperTexture(width, height, 1));
+	auto* hardware = texture->GetHardwareTexture(0, 0);
+	if (compressed)
+		hardware->CreateTexture(pixels, width, height, -1, false, 1, name);
+	else
+		hardware->CreateTexture(pixels, width, height, -1, false, name, true);
+	hardware->FinishTextureUpload();
+	return std::unique_ptr<FGameTexture>(new FGameTexture(texture.get(), name));
+}
