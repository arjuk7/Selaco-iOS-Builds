+
+FxExpression* FxFStateOffset::Resolve(FCompileContext& ctx)
+{
+	CHECKRESOLVED();
+	if (State && Offset)
+	{
+		RESOLVE(State, ctx);
+		RESOLVE(Offset, ctx);
+		ABORT(State && Offset);
+		assert(State->ValueType == ValueType);
+		assert(Offset->IsInteger());
+	}
+	return this;
+};
+
