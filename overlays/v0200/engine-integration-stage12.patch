+// Owned fd4b0b60d8: a resource ending in "files" is not an optional mod.
+static bool IsModResource(const std::string& path)
+{
+	return path.size() >= 5 && !stricmp(path.c_str() + path.size() - 5, "files");
+}
+
+static bool HasModFilesFrom(const FString& path)
+{
+	FileSys::FileList list;
+	if (!FileSys::ScanDirectory(list, path.GetChars(), "*.*", true)) return false;
+	for (const auto& entry : list)
+	{
+		const char* extension = strrchr(entry.FileName.c_str(), '.');
+		if (extension && !entry.isDirectory &&
+			(!stricmp(extension, ".wad") || !stricmp(extension, ".pk3") || !stricmp(extension, ".pk7"))) return true;
+	}
+	return false;
+}
+
+static bool HasInstalledModFiles()
+{
+	FStringf path("%s/Mods/", progdir.GetChars());
+	if (HasModFilesFrom(path) || HasModFilesFrom(path + "Workshop/")) return true;
+	FILE* workshop = fopen((path + "workshop.txt").GetChars(), "r");
+	if (!workshop) return false;
+	char line[1024];
+	bool found = false;
+	fgets(line, sizeof(line), workshop); // Workshop export header.
+	while (fgets(line, sizeof(line), workshop))
+	{
+		const size_t length = strnlen(line, sizeof(line));
+		if (length <= 4) continue;
+		line[length - 1] = 0;
+		const char* extension = strrchr(line, '.');
+		if (extension && !strnicmp(extension, ".pk3", sizeof(line))) { found = true; break; }
+	}
+	fclose(workshop);
+	return found;
+}
+
+static void UpdateModStatus(const std::vector<std::string>& pwads)
+{
+	// The private semantic compiler never enumerates user mod directories.
+	bool found = false;
+#if !defined(SELACO_PRIVATE_COMPILE_HARNESS)
+	found = HasInstalledModFiles();
+#endif
+	if (!found)
+		for (const auto& file : pwads)
+			if (!IsModResource(file)) { found = true; break; }
+	UCVarValue value;
+	value.Bool = found;
+	modsexist->ForceSet(value, CVAR_Bool);
+	if (!enablemods && !found) enablemods = true;
+}
+
 
