+void VkTextureManager::SetLightmapRGBA(int width, int height, int layers, bool rgbaSliceView)
+{
+	Lightmap.Reset(fb);
+	LightmapSlices.clear();
+	LightmapSliceFormat = rgbaSliceView ? VK_FORMAT_R8G8B8A8_UNORM : VK_FORMAT_B8G8R8A8_UNORM;
